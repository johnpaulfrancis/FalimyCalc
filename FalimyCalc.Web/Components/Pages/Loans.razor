                <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                    <table class="table table-sm table-hover mb-0" style="font-size: 0.8rem;">
                        <thead class="table-light sticky-top" style="background: var(--dash-surface-raised);">
                            <tr>
                                <th>#</th>
                                <th>Date</th>
                                <th>Beginning</th>
                                <th>EMI</th>
                                <th>Principal</th>
                                <th>Interest</th>
                                <th>Ending Bal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in ActiveSchedule)
                            {
                                <tr>
