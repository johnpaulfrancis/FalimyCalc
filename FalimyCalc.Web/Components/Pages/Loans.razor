            <div class="modal-panel-body">
                <div class="p-3 rounded-3 mb-3" style="background: var(--dash-surface-raised); border: 1px solid var(--dash-border);">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <strong style="color: var(--dash-text);">@LoanToPay.Name</strong>
                        <span class="badge bg-secondary-subtle text-secondary">@LoanToPay.LoanType</span>
                    </div>
                    <div class="small text-muted">
                        Outstanding Balance: <strong>₹@LoanToPay.OutstandingBalance.ToString("N2")</strong>
