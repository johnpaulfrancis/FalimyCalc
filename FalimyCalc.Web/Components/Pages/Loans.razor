            </div>
        </div>
    </div>
}

<!-- ── Amortization Schedule Modal ────────────────────────────────────────── -->
@if (LoanForSchedule != null)
{
    <div class="modal-backdrop-custom" @onclick="() => LoanForSchedule = null">
        <div class="modal-panel shadow-lg animate-in" style="max-width: 680px;" @onclick:stopPropagation="true">
            <div class="modal-panel-header">
                <div>
                    <h5 class="mb-0 fw-bold d-flex align-items-center gap-2">
                        <span>📄 Repayment Schedule: @LoanForSchedule.Name</span>
                    </h5>
                    <span class="small text-muted">₹@LoanForSchedule.PrincipalAmount.ToString("N0") @LoanForSchedule.InterestRate% p.a. for @LoanForSchedule.TenureMonths months</span>
                </div>
                <button type="button" class="btn-close" @onclick="() => LoanForSchedule = null"></button>
            </div>
