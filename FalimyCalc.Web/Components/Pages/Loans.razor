                <div class="mb-3">
                    <label class="form-label small fw-semibold text-uppercase text-muted">Payment Type</label>
                    <select class="form-select" @bind="PaymentType">
                        <option value="EMI">Monthly Installment (EMI)</option>
                        <option value="Prepayment">Extra Principal Prepayment</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-uppercase text-muted">Payment Amount (₹) <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" min="1" class="form-control form-control-lg fw-bold" @bind="PaymentAmount" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-uppercase text-muted">Payment Date <span class="text-danger">*</span></label>
                    <input type="date" class="form-control" @bind="PaymentDate" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-uppercase text-muted">Debit From Bank Account</label>
                    <select class="form-select" @bind="PaymentAccountString">
                        <option value="">🏦 Any / Unspecified</option>
                        @foreach (var acc in BankAccounts)
                        {
                            <option value="@acc.GlobalId">@acc.Icon @acc.AccountName (Bal: ₹@acc.InitialBalance.ToString("N0"))</option>
                        }
                    </select>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => LoanToPay = null">Cancel</button>
                    <button type="button" class="btn btn-success px-4 fw-semibold" @onclick="ExecutePaymentAsync" disabled="@IsSaving">
                        @(IsSaving ? "Recording..." : "Confirm Payment ✓")
