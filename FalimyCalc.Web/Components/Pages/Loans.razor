        overflow: hidden;
        z-index: 1060;
    }
    .modal-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.1rem 1.25rem;
        border-bottom: 1px solid var(--dash-border, #e2e8f0);
