                                    <td class="text-success">₹@row.PrincipalPaid.ToString("N0")</td>
                                    <td class="text-muted">₹@row.InterestPaid.ToString("N0")</td>
                                    <td class="fw-semibold">₹@row.EndingBalance.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

<!-- ── Interactive Standalone EMI Calculator Modal ────────────────────────── -->
@if (ShowCalculatorModal)
{
    <div class="modal-backdrop-custom" @onclick="() => ShowCalculatorModal = false">
        <div class="modal-panel shadow-lg animate-in" style="max-width: 500px;" @onclick:stopPropagation="true">
            <div class="modal-panel-header">
                <h5 class="mb-0 fw-bold d-flex align-items-center gap-2">
                    <span>🧮 Smart EMI Calculator</span>
                </h5>
                <button type="button" class="btn-close" @onclick="() => ShowCalculatorModal = false"></button>
            </div>
            <div class="modal-panel-body">
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-uppercase text-muted">Loan Amount (₹)</label>
                    <input type="number" step="10000" min="1000" class="form-control" @bind="CalcPrincipal" @bind:event="oninput" @bind:after="RunCalculator" />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold text-uppercase text-muted">Interest Rate (% p.a.)</label>
                        <input type="number" step="0.1" min="0" max="40" class="form-control" @bind="CalcRate" @bind:event="oninput" @bind:after="RunCalculator" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold text-uppercase text-muted">Tenure (Months)</label>
                        <input type="number" min="1" max="480" class="form-control" @bind="CalcMonths" @bind:event="oninput" @bind:after="RunCalculator" />
                    </div>
                </div>

                <!-- Results Card -->
                <div class="p-3 rounded-3 mb-3" style="background: var(--dash-surface-raised); border: 1px solid var(--dash-border);">
                    <div class="text-center mb-3">
                        <span class="small text-muted text-uppercase fw-semibold d-block">Monthly EMI Amount</span>
                        <h2 class="fw-bold mb-0" style="color: var(--c-rose, #f43f5e);">
                            ₹ @CalcEmi.ToString("N2")
                        </h2>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-top small" style="border-color: var(--dash-border) !important;">
                        <span class="text-muted">Total Principal:</span>
                        <strong>₹ @CalcPrincipal.ToString("N2")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-top small" style="border-color: var(--dash-border) !important;">
                        <span class="text-muted">Total Interest Payable:</span>
                        <strong class="text-danger">₹ @CalcTotalInterest.ToString("N2")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-top small" style="border-color: var(--dash-border) !important;">
                        <span class="text-muted">Total Repayment (P + I):</span>
                        <strong class="text-primary">₹ @CalcTotalAmount.ToString("N2")</strong>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ShowCalculatorModal = false">Close</button>
                    <button type="button" class="btn btn-primary btn-sm px-3" @onclick="TransferCalcToNewLoan">
                        ➕ Create Loan With These Numbers
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ── Delete Confirmation Modal ─────────────────────────────────────────── -->
@if (LoanToDelete != null)
{
    <div class="modal-backdrop-custom" @onclick="() => LoanToDelete = null">
        <div class="modal-panel shadow-lg animate-in" style="max-width: 420px;" @onclick:stopPropagation="true">
