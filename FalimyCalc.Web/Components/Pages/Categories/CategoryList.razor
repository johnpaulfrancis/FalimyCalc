@code {
    private List<Category> Categories = [];
    private Dictionary<Guid, ExpenseService.CategoryBudgetStatus> BudgetStatuses = [];
    private bool IsLoading = true;
    private bool ShowForm = false;
    private bool IsSaving = false;
    private string? FormError;

    // Filters & Search
    private string SearchText = string.Empty;
    private string ActiveStatusFilter = "all";
    private string SelectedSort = "name_asc";

    // Admin view toggle
    private bool _showAllMembers = true;
    private string? SelectedMemberId;

    // Form fields
    private string FormName = string.Empty;
    private string FormIcon = string.Empty;
    private string FormColour = "#6366f1";
    private decimal? FormMonthlyBudget;

    private Category? EditingCategory;
    private Category? CategoryToDelete;

    // Preset Emojis & Colors
    private record EmojiPreset(string Icon, string Name);
    private readonly List<EmojiPreset> PresetEmojis =
    [
        new("🛒", "Groceries"),
        new("🍔", "Dining"),
        new("🚗", "Transport / Fuel"),
        new("⚡", "Utilities"),
        new("🏠", "Housing / Rent"),
        new("💊", "Health & Pharmacy"),
        new("🎬", "Entertainment"),
        new("🛍️", "Shopping"),
        new("✈️", "Travel"),
        new("🎓", "Education"),
        new("🎁", "Gifts"),
        new("💼", "Work"),
        new("🐾", "Pets"),
        new("📱", "Phone & Internet"),
        new("🏋️", "Fitness"),
        new("👶", "Baby / Kids"),
        new("☕", "Coffee / Snacks"),
        new("🎮", "Games & Hobbies")
    ];

    private readonly List<string> PresetColors =
    [
        "#6366f1", // Indigo
        "#10b981", // Emerald
        "#f43f5e", // Rose
        "#f59e0b", // Amber
        "#06b6d4", // Cyan
        "#3b82f6", // Blue
        "#a855f7", // Purple
        "#ec4899", // Pink
        "#f97316", // Orange
        "#14b8a6"  // Teal
    ];

    private Guid? ActiveMemberFilter
    {
        get
        {
            if (Session.CurrentUser?.Role != "Admin")
                return Session.CurrentUser?.GlobalId;

            if (Guid.TryParse(SelectedMemberId, out var g))
                return g;

            return _showAllMembers ? null : Session.CurrentUser?.GlobalId;
        }
    }

    // Computed KPI Metrics
    private decimal TotalAllocatedBudget => Categories.Where(c => c.MonthlyBudget.HasValue).Sum(c => c.MonthlyBudget!.Value);
    private decimal TotalSpentThisMonth => BudgetStatuses.Values.Sum(s => s.Spent);
    private decimal RemainingBudget => TotalAllocatedBudget - TotalSpentThisMonth;

    private int OverBudgetCount => BudgetStatuses.Values.Count(s => s.IsOverBudget);
    private int NearLimitCount => BudgetStatuses.Values.Count(s => s.IsNearLimit);
    private int OnTrackCount => Categories.Count(c =>
    {
        if (!c.MonthlyBudget.HasValue || c.MonthlyBudget.Value == 0) return false;
        return BudgetStatuses.TryGetValue(c.GlobalId, out var s) && !s.IsOverBudget && !s.IsNearLimit;
    });
    private int NoBudgetCount => Categories.Count(c => !c.MonthlyBudget.HasValue || c.MonthlyBudget.Value == 0);

    // Filtered & Sorted Categories
    private IEnumerable<Category> FilteredCategories
    {
        get
        {
            var query = Categories.AsEnumerable();

            // Search Filter
            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                var term = SearchText.Trim();
                query = query.Where(c => c.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                                      || (!string.IsNullOrEmpty(c.Icon) && c.Icon.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            // Status Filter
            switch (ActiveStatusFilter)
            {
                case "over":
                    query = query.Where(c => BudgetStatuses.TryGetValue(c.GlobalId, out var s) && s.IsOverBudget);
                    break;
                case "near":
                    query = query.Where(c => BudgetStatuses.TryGetValue(c.GlobalId, out var s) && s.IsNearLimit);
                    break;
                case "ontrack":
                    query = query.Where(c => c.MonthlyBudget.HasValue && c.MonthlyBudget.Value > 0
                                         && BudgetStatuses.TryGetValue(c.GlobalId, out var s)
                                         && !s.IsOverBudget && !s.IsNearLimit);
                    break;
                case "nobudget":
                    query = query.Where(c => !c.MonthlyBudget.HasValue || c.MonthlyBudget.Value == 0);
                    break;
            }

            // Sorting
            query = SelectedSort switch
            {
                "spent_desc" => query.OrderByDescending(c => BudgetStatuses.TryGetValue(c.GlobalId, out var s) ? s.Spent : 0m),
                "budget_desc" => query.OrderByDescending(c => c.MonthlyBudget ?? 0m),
                "pct_desc" => query.OrderByDescending(c => BudgetStatuses.TryGetValue(c.GlobalId, out var s) ? s.PercentUsed : 0),
                _ => query.OrderBy(c => c.Name)
            };

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Session.CurrentUser?.Role != "Admin")
        {
            _showAllMembers = false;
        }
        await LoadCategories();
    }

    private async Task SetViewMode(bool showAll)
    {
        _showAllMembers = showAll;
        SelectedMemberId = null;
        await LoadCategories();
    }

    private void ResetFilters()
    {
        SearchText = string.Empty;
        ActiveStatusFilter = "all";
    }

    private async Task LoadCategories()
    {
        IsLoading = true;
        Categories = await ExpenseService.GetCategoriesAsync();
        var statuses = await ExpenseService.GetCategoryBudgetStatusesAsync(DateTime.Today.Year, DateTime.Today.Month, ActiveMemberFilter);
        BudgetStatuses = statuses.ToDictionary(s => s.CategoryId);
        IsLoading = false;
    }

    private void ShowAddForm()
    {
        EditingCategory = null;
        FormName = string.Empty;
        FormIcon = "🛒";
        FormColour = "#6366f1";
        FormMonthlyBudget = null;
        FormError = null;
        ShowForm = true;
    }

    private void StartEdit(Category cat)
    {
        EditingCategory = cat;
        FormName = cat.Name;
        FormIcon = cat.Icon ?? "📁";
        FormColour = cat.Colour ?? "#6366f1";
        FormMonthlyBudget = cat.MonthlyBudget;
        FormError = null;
        ShowForm = true;
    }

    private void HideForm()
    {
        ShowForm = false;
        EditingCategory = null;
        FormError = null;
    }

    private async Task SaveCategory()
    {
        FormError = null;

        if (string.IsNullOrWhiteSpace(FormName))
        {
            FormError = "Category name is required.";
            return;
        }

        IsSaving = true;

        try
        {
            if (EditingCategory is null)
            {
                await ExpenseService.CreateCategoryAsync(new Category
                {
                    Name = FormName.Trim(),
                    Icon = string.IsNullOrWhiteSpace(FormIcon) ? null : FormIcon.Trim(),
                    Colour = FormColour,
                    MonthlyBudget = FormMonthlyBudget
                });
            }
            else
            {
                await ExpenseService.UpdateCategoryAsync(new Category
                {
                    GlobalId = EditingCategory.GlobalId,
                    Name = FormName.Trim(),
                    Icon = string.IsNullOrWhiteSpace(FormIcon) ? null : FormIcon.Trim(),
                    Colour = FormColour,
                    MonthlyBudget = FormMonthlyBudget
                });
            }

            HideForm();
            await LoadCategories();
        }
        catch (Exception ex)
        {
            FormError = $"Failed to save category: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void ConfirmDelete(Category cat) => CategoryToDelete = cat;
    private void CancelDelete() => CategoryToDelete = null;

    private async Task DeleteConfirmed()
    {
        if (CategoryToDelete is not null)
        {
            await ExpenseService.DeleteCategoryAsync(CategoryToDelete.GlobalId);
            CategoryToDelete = null;
            await LoadCategories();
        }
    }
}
