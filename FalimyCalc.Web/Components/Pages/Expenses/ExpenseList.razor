@code {
    private List<Expense> Expenses = [];
    private List<Category> Categories = [];
    private List<BankAccount> BankAccounts = [];
    private List<FamilyMember> FamilyMembers = [];
    private Dictionary<Guid, FamilyMember> MemberMap = [];

    private bool IsLoading = true;
    private int TotalCount;
    private decimal TotalAmount;
    private int CurrentPage = 1;
    private int PageSize = 20;
    private int TotalPages => (int)Math.Ceiling((double)TotalCount / PageSize);

    [SupplyParameterFromQuery(Name = "categoryId")]
    public string? QueryCategoryId { get; set; }

    [SupplyParameterFromQuery(Name = "accountId")]
    public string? QueryAccountId { get; set; }

    private string? SearchTerm;
    private string? SelectedCategoryId;
    private string? SelectedAccountId;
    private string? SelectedMemberId;
    private string SelectedTransactionType = "all";
    private string SelectedSortBy = "date_desc";
    private string ActiveDatePreset = "all";
    private bool _showAllMembers = false;

    private DateTime? FromDate;
    private DateTime? ToDate;

    private Expense? ExpenseToDelete;
    private Expense? SelectedExpenseDetails;

    private System.Timers.Timer? _searchDebounce;

    private bool IsFiltered =>
        !string.IsNullOrWhiteSpace(SearchTerm) ||
        !string.IsNullOrEmpty(SelectedCategoryId) ||
        !string.IsNullOrEmpty(SelectedAccountId) ||
        !string.IsNullOrEmpty(SelectedMemberId) ||
        SelectedTransactionType != "all" ||
        FromDate.HasValue ||
        ToDate.HasValue ||
        ActiveDatePreset != "all";

    private Guid? ActiveMemberFilter
    {
        get
        {
            if (Session.CurrentUser?.Role != "Admin")
                return Session.CurrentUser?.GlobalId;

            if (Guid.TryParse(SelectedMemberId, out var g))
                return g;

            return _showAllMembers ? null : Session.CurrentUser?.GlobalId;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Categories = await ExpenseService.GetCategoriesAsync();
        FamilyMembers = await ExpenseService.GetFamilyMembersAsync();
        MemberMap = FamilyMembers.ToDictionary(m => m.GlobalId);

        _showAllMembers = false;

        BankAccounts = await ExpenseService.GetBankAccountsAsync(ActiveMemberFilter);

        if (!string.IsNullOrEmpty(QueryCategoryId))
        {
            SelectedCategoryId = QueryCategoryId;
        }

        if (!string.IsNullOrEmpty(QueryAccountId))
        {
            SelectedAccountId = QueryAccountId;
        }

        await LoadExpenses();
    }

    protected override async Task OnParametersSetAsync()
    {
        bool shouldReload = false;

        if (!string.IsNullOrEmpty(QueryCategoryId) && SelectedCategoryId != QueryCategoryId)
        {
            SelectedCategoryId = QueryCategoryId;
            shouldReload = true;
        }

        if (!string.IsNullOrEmpty(QueryAccountId) && SelectedAccountId != QueryAccountId)
        {
            SelectedAccountId = QueryAccountId;
            shouldReload = true;
        }

        if (shouldReload)
        {
            CurrentPage = 1;
            await LoadExpenses();
        }
    }

    private async Task SetViewMode(bool showAll)
    {
        _showAllMembers = showAll;
        SelectedMemberId = null;
        BankAccounts = await ExpenseService.GetBankAccountsAsync(ActiveMemberFilter);
        CurrentPage = 1;
        await LoadExpenses();
    }

    private async Task OnMemberFilterChanged()
    {
        CurrentPage = 1;
        if (string.IsNullOrEmpty(SelectedMemberId))
        {
            _showAllMembers = true;
        }
        else if (Guid.TryParse(SelectedMemberId, out var sg) && sg == Session.CurrentUser?.GlobalId)
        {
            _showAllMembers = false;
        }
        BankAccounts = await ExpenseService.GetBankAccountsAsync(ActiveMemberFilter);
        await LoadExpenses();
    }

    private async Task OnFilterChanged()
    {
        CurrentPage = 1;
        await LoadExpenses();
    }

    private async Task OnPageSizeChanged()
    {
        CurrentPage = 1;
        await LoadExpenses();
    }

    private async Task SetQuickDateRange(string preset)
    {
        ActiveDatePreset = preset;
        var today = DateTime.Today;

        switch (preset)
        {
            case "this_month":
                FromDate = new DateTime(today.Year, today.Month, 1);
                ToDate = today;
                break;
            case "last_month":
                var lastMonth = today.AddMonths(-1);
                FromDate = new DateTime(lastMonth.Year, lastMonth.Month, 1);
                ToDate = new DateTime(today.Year, today.Month, 1).AddDays(-1);
                break;
            case "last_30":
                FromDate = today.AddDays(-30);
                ToDate = today;
                break;
            case "this_year":
                FromDate = new DateTime(today.Year, 1, 1);
                ToDate = today;
                break;
            case "all":
            default:
                FromDate = null;
                ToDate = null;
                break;
        }

        CurrentPage = 1;
        await LoadExpenses();
    }

    private async Task OnCustomDateChanged()
    {
        ActiveDatePreset = "custom";
        CurrentPage = 1;
        await LoadExpenses();
    }

    private async Task LoadExpenses()
    {
        IsLoading = true;
        Guid? catId = Guid.TryParse(SelectedCategoryId, out var g) ? g : null;
        Guid? accId = Guid.TryParse(SelectedAccountId, out var ag) ? ag : null;

        var result = await ExpenseService.GetExpensesAsync(
            page: CurrentPage,
            pageSize: PageSize,
            searchTerm: SearchTerm,
            categoryGlobalId: catId,
            accountGlobalId: accId,
            fromDate: FromDate,
            toDate: ToDate,
            memberGlobalId: ActiveMemberFilter,
            sortBy: SelectedSortBy,
            transactionType: SelectedTransactionType);

        Expenses = result.Items;
        TotalCount = result.TotalCount;
        TotalAmount = result.TotalAmount;
        IsLoading = false;
    }

    private void OnSearchChanged()
    {
        _searchDebounce?.Dispose();
        _searchDebounce = new System.Timers.Timer(350);
        _searchDebounce.Elapsed += async (_, _) =>
        {
            _searchDebounce?.Dispose();
            CurrentPage = 1;
            await InvokeAsync(async () =>
            {
                await LoadExpenses();
                StateHasChanged();
            });
        };
        _searchDebounce.AutoReset = false;
        _searchDebounce.Start();
    }

    private async Task ClearSearch()
    {
        SearchTerm = null;
        CurrentPage = 1;
        await LoadExpenses();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || (TotalPages > 0 && page > TotalPages)) return;
        CurrentPage = page;
        await LoadExpenses();
    }

    private async Task ClearFilters()
    {
        SearchTerm = null;
        SelectedCategoryId = null;
        SelectedAccountId = null;
        SelectedMemberId = null;
        SelectedTransactionType = "all";
        SelectedSortBy = "date_desc";
        ActiveDatePreset = "all";
        FromDate = null;
        ToDate = null;
        CurrentPage = 1;
        _showAllMembers = false;
        BankAccounts = await ExpenseService.GetBankAccountsAsync(ActiveMemberFilter);
        await LoadExpenses();
    }

    private void ViewExpenseDetails(Expense exp) => SelectedExpenseDetails = exp;
    private void CloseDetailsModal() => SelectedExpenseDetails = null;

    private async Task ConvertType(Expense expense, bool makeIncome)
    {
        var target = makeIncome ? "income" : "expense";
        var res = await ExpenseService.ConvertTransactionTypeAsync(expense.GlobalId, target);
        if (res != null)
        {
            await LoadExpenses();
            StateHasChanged();
        }
    }

    private async Task ConvertTypeFromModal(Expense expense, bool makeIncome)
    {
        var target = makeIncome ? "income" : "expense";
        var res = await ExpenseService.ConvertTransactionTypeAsync(expense.GlobalId, target);
        if (res != null)
        {
            SelectedExpenseDetails = res;
            await LoadExpenses();
            StateHasChanged();
        }
    }

    private void ConfirmDelete(Expense expense) => ExpenseToDelete = expense;
    private void CancelDelete() => ExpenseToDelete = null;

    private async Task DeleteConfirmed()
    {
        if (ExpenseToDelete is not null)
        {
            await ExpenseService.DeleteExpenseAsync(ExpenseToDelete.GlobalId);
            if (SelectedExpenseDetails?.GlobalId == ExpenseToDelete.GlobalId)
            {
                SelectedExpenseDetails = null;
            }
            ExpenseToDelete = null;
            await LoadExpenses();
        }
    }

    // ── Export Handlers ─────────────────────────────────────────────────────
    private bool IsExporting = false;

    private async Task ExportToCsv()
    {
        try
        {
            IsExporting = true;
            StateHasChanged();

            Guid? catId = Guid.TryParse(SelectedCategoryId, out var g) ? g : null;
            Guid? accId = Guid.TryParse(SelectedAccountId, out var ag) ? ag : null;
            var allFiltered = await ExpenseService.GetAllExpensesAsync(
                searchTerm: SearchTerm,
                categoryGlobalId: catId,
                accountGlobalId: accId,
                fromDate: FromDate,
                toDate: ToDate,
                memberGlobalId: ActiveMemberFilter);

            var bytes = ExportService.ExportExpensesToCsv(allFiltered);
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"Expenses_{DateTime.Now:yyyyMMdd_HHmmss}.csv";

            await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, "text/csv;charset=utf-8", base64);
        }
        finally
        {
            IsExporting = false;
            StateHasChanged();
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            IsExporting = true;
            StateHasChanged();

            Guid? catId = Guid.TryParse(SelectedCategoryId, out var g) ? g : null;
            Guid? accId = Guid.TryParse(SelectedAccountId, out var ag) ? ag : null;
            var allFiltered = await ExpenseService.GetAllExpensesAsync(
                searchTerm: SearchTerm,
                categoryGlobalId: catId,
                accountGlobalId: accId,
                fromDate: FromDate,
                toDate: ToDate,
                memberGlobalId: ActiveMemberFilter);

            var title = "FalimyCalc - Expenses Export";
            if (FromDate.HasValue || ToDate.HasValue)
            {
                var fromStr = FromDate?.ToString("dd MMM yyyy") ?? "Start";
                var toStr = ToDate?.ToString("dd MMM yyyy") ?? "Present";
                title += $" ({fromStr} - {toStr})";
            }

            var bytes = ExportService.ExportExpensesToExcel(allFiltered, title);
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"Expenses_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";

            await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64);
        }
        finally
        {
            IsExporting = false;
            StateHasChanged();
        }
    }

    // ── Excel Import State & Handlers ───────────────────────────────────────
    private bool ShowImportModal = false;
    private bool IsImporting = false;
    private string? ImportErrorMessage;
    private ExpenseService.ImportResult? ImportResultInfo;
    private List<ExpenseService.ImportExpenseItem> ParsedPreviewItems = [];

    private void OpenImportModal()
    {
        ShowImportModal = true;
        ImportErrorMessage = null;
        ImportResultInfo = null;
        ParsedPreviewItems = [];
    }

    private void CloseImportModal()
    {
        ShowImportModal = false;
        ImportErrorMessage = null;
        ImportResultInfo = null;
        ParsedPreviewItems = [];
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        ImportErrorMessage = null;
        ImportResultInfo = null;
        ParsedPreviewItems = [];

        var file = e.File;
        if (file is null) return;

        const long maxFileSize = 10 * 1024 * 1024;
        if (file.Size > maxFileSize)
        {
            ImportErrorMessage = "File size exceeds the 10 MB limit.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            ParsedPreviewItems = ExportService.ParseExpensesFromExcel(ms);
            if (!ParsedPreviewItems.Any())
            {
                ImportErrorMessage = "No expense rows were found in the uploaded Excel worksheet.";
            }
        }
        catch (Exception ex)
        {
            ImportErrorMessage = $"Failed to parse Excel file: {ex.Message}";
        }
    }

    private async Task ExecuteImportAsync()
    {
        if (!ParsedPreviewItems.Any()) return;

        try
        {
            IsImporting = true;
            ImportErrorMessage = null;
            StateHasChanged();

            ImportResultInfo = await ExpenseService.ImportExpensesBatchAsync(ParsedPreviewItems, Session.CurrentUser?.GlobalId);

            Categories = await ExpenseService.GetCategoriesAsync();
            await LoadExpenses();
        }
        catch (Exception ex)
        {
            var innermost = ex;
            while (innermost.InnerException is not null)
            {
                innermost = innermost.InnerException;
            }
            ImportErrorMessage = $"Import failed: {innermost.Message}";
        }
        finally
        {
            IsImporting = false;
            StateHasChanged();
        }
    }
}
