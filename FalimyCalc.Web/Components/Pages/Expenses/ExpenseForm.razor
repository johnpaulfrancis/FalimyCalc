@code {
    [Parameter] public Guid? GlobalId { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string? QueryType { get; set; }
    [SupplyParameterFromQuery(Name = "categoryId")] public string? QueryCategoryId { get; set; }
    [SupplyParameterFromQuery(Name = "accountId")] public string? QueryAccountId { get; set; }
    [SupplyParameterFromQuery(Name = "sourceAccountId")] public string? QuerySourceAccountId { get; set; }
    [SupplyParameterFromQuery(Name = "destAccountId")] public string? QueryDestAccountId { get; set; }

    private bool IsEditMode => GlobalId.HasValue;
    private bool IsLoading = true;
    private bool IsSaving = false;
    private bool SuccessAlert = false;
    private string SuccessMessage = "Transaction saved successfully!";
    private bool ShowExtraDetails = false;
    private string? ErrorMessage;

    private bool ShowDuplicateWarningModal = false;
    private Expense? DetectedDuplicateExpense;
    private string DuplicateConfirmTarget = "submit";

    // Type mode: "expense" | "income" | "transfer"
    private string SelectedType = "expense";

    private List<Category> Categories = [];
    private List<FamilyMember> FamilyMembers = [];
    private List<BankAccount> AllBankAccounts = [];
    private List<ExpenseService.BankAccountWithBalance> AccountsWithBalances = [];
    private Dictionary<Guid, ExpenseService.CategoryBudgetStatus> BudgetStatuses = [];

    private string? SelectedCategoryId;
    private string? SelectedMemberId;
    private string? SelectedAccountString;

    // Transfer fields
    private Guid? TransferSourceAccountId;
    private string? TransferSourceAccountString
    {
        get => TransferSourceAccountId?.ToString();
        set
        {
            if (Guid.TryParse(value, out var g)) TransferSourceAccountId = g;
            else TransferSourceAccountId = null;
        }
    }
    private Guid? TransferDestAccountId;
    private string? TransferDestAccountString
    {
        get => TransferDestAccountId?.ToString();
        set
        {
            if (Guid.TryParse(value, out var g)) TransferDestAccountId = g;
            else TransferDestAccountId = null;
        }
    }
    private decimal TransferAmount;
    private DateTime TransferDate = DateTime.Now;
    private string TransferDescription = string.Empty;
    private string? TransferNote;

    private List<BankAccount> AvailableBankAccountsList
    {
        get
        {
            if (Guid.TryParse(SelectedMemberId, out var mId))
            {
                var filtered = AllBankAccounts.Where(a => a.MemberGlobalId == mId || a.HasMemberAccess(mId)).ToList();
                if (filtered.Any()) return filtered;
            }
            return AllBankAccounts;
        }
    }

    private Category? SelectedCategory =>
        Guid.TryParse(SelectedCategoryId, out var g) ? Categories.FirstOrDefault(c => c.GlobalId == g) : null;

    private FamilyMember? SelectedMember =>
        Guid.TryParse(SelectedMemberId, out var g) ? FamilyMembers.FirstOrDefault(m => m.GlobalId == g) : null;

    private BankAccount? SelectedBankAccount =>
        Model.AccountGlobalId.HasValue ? AllBankAccounts.FirstOrDefault(a => a.GlobalId == Model.AccountGlobalId.Value) : null;

    private BankAccount? TransferSourceAccount =>
        TransferSourceAccountId.HasValue ? AllBankAccounts.FirstOrDefault(a => a.GlobalId == TransferSourceAccountId.Value) : null;

    private BankAccount? TransferDestAccount =>
        TransferDestAccountId.HasValue ? AllBankAccounts.FirstOrDefault(a => a.GlobalId == TransferDestAccountId.Value) : null;

    private ExpenseService.CategoryBudgetStatus? SelectedCategoryBudget =>
        Guid.TryParse(SelectedCategoryId, out var g) && BudgetStatuses.TryGetValue(g, out var s) ? s : null;

    private record SuggestionItem(string Text, string? CategoryName = null);
    private readonly List<SuggestionItem> CommonSuggestions =
    [
        new("🛒 Groceries"),
        new("⛽ Petrol / Fuel"),
        new("⚡ Electricity Bill"),
        new("🍕 Dining Out"),
        new("💊 Medicines"),
        new("🥛 Milk & Bread"),
        new("📶 Mobile Recharge")
    ];

    private readonly List<SuggestionItem> IncomeSuggestions =
    [
        new("💼 Monthly Salary"),
        new("💻 Freelance / Project"),
        new("📈 Dividend / Investment"),
        new("🎁 Cash Gift"),
        new("🏦 Bank Interest"),
        new("🏷️ Cashback / Refund"),
        new("🏠 Rental Income")
    ];

    private readonly List<string> TransferSuggestions =
    [
        "🏧 ATM Cash Withdrawal",
        "💳 Credit Card Bill Pay",
        "💰 Savings Allocation",
        "📱 Wallet Top-up",
        "🏦 Inter-bank Transfer"
    ];

    private ExpenseFormModel Model = new();

    private class ExpenseFormModel
    {
        public decimal Amount { get; set; }
        public string Description { get; set; } = string.Empty;
        public DateTime TransactionDate { get; set; } = DateTime.Now;
        public Guid? AccountGlobalId { get; set; }
        public string? Account { get; set; }
        public string? Note { get; set; }
        public string? Subcategory { get; set; }
        public string? Tags { get; set; }
    }

    private DateOnly TransactionDateOnly
    {
        get => DateOnly.FromDateTime(Model.TransactionDate);
        set => Model.TransactionDate = new DateTime(value.Year, value.Month, value.Day, Model.TransactionDate.Hour, Model.TransactionDate.Minute, Model.TransactionDate.Second);
    }

    private TimeOnly TransactionTimeOnly
    {
        get => TimeOnly.FromDateTime(Model.TransactionDate);
        set => Model.TransactionDate = new DateTime(Model.TransactionDate.Year, Model.TransactionDate.Month, Model.TransactionDate.Day, value.Hour, value.Minute, 0);
    }

    private void SetTransactionTimeToNow()
    {
        var now = DateTime.Now;
        Model.TransactionDate = new DateTime(Model.TransactionDate.Year, Model.TransactionDate.Month, Model.TransactionDate.Day, now.Hour, now.Minute, 0);
    }

    private void SetTransactionTime(int hour, int minute)
    {
        Model.TransactionDate = new DateTime(Model.TransactionDate.Year, Model.TransactionDate.Month, Model.TransactionDate.Day, hour, minute, 0);
    }

    private void SetTransactionDate(DateTime date)
    {
        Model.TransactionDate = new DateTime(date.Year, date.Month, date.Day, Model.TransactionDate.Hour, Model.TransactionDate.Minute, Model.TransactionDate.Second);
    }

    private DateOnly TransferDateOnly
    {
        get => DateOnly.FromDateTime(TransferDate);
        set => TransferDate = new DateTime(value.Year, value.Month, value.Day, TransferDate.Hour, TransferDate.Minute, TransferDate.Second);
    }

    private TimeOnly TransferTimeOnly
    {
        get => TimeOnly.FromDateTime(TransferDate);
        set => TransferDate = new DateTime(TransferDate.Year, TransferDate.Month, TransferDate.Day, value.Hour, value.Minute, 0);
    }

    private void SetTransferTimeToNow()
    {
        var now = DateTime.Now;
        TransferDate = new DateTime(TransferDate.Year, TransferDate.Month, TransferDate.Day, now.Hour, now.Minute, 0);
    }

    private void SetTransferDate(DateTime date)
    {
        TransferDate = new DateTime(date.Year, date.Month, date.Day, TransferDate.Hour, TransferDate.Minute, TransferDate.Second);
    }

    protected override async Task OnInitializedAsync()
    {
        Categories = await ExpenseService.GetCategoriesAsync();
        FamilyMembers = await ExpenseService.GetFamilyMembersAsync();
        AllBankAccounts = await ExpenseService.GetBankAccountsAsync();
        AccountsWithBalances = await ExpenseService.GetBankAccountsWithBalancesAsync();
        SelectedMemberId = Session.CurrentUser?.GlobalId.ToString();

        var statuses = await ExpenseService.GetCategoryBudgetStatusesAsync(DateTime.Today.Year, DateTime.Today.Month);
        BudgetStatuses = statuses.ToDictionary(s => s.CategoryId);

        if (!string.IsNullOrEmpty(QueryType))
        {
            SetTransactionType(QueryType.ToLowerInvariant());
        }

        if (!string.IsNullOrEmpty(QueryCategoryId))
        {
            SelectedCategoryId = QueryCategoryId;
        }

        if (IsEditMode)
        {
            var expense = await ExpenseService.GetExpenseAsync(GlobalId!.Value);
            if (expense is null)
            {
                Nav.NavigateTo("/expenses");
                return;
            }

            // Security: Non-admin can only edit their own expenses
            if (Session.CurrentUser?.Role != "Admin" && expense.MemberGlobalId.HasValue && expense.MemberGlobalId.Value != Session.CurrentUser?.GlobalId)
            {
                Nav.NavigateTo("/expenses");
                return;
            }

            Model.Amount = Math.Abs(expense.Amount);
            Model.Description = expense.Description;
            Model.TransactionDate = expense.TransactionDate;
            Model.Account = expense.Account;
            Model.AccountGlobalId = expense.AccountGlobalId;
            Model.Note = expense.Note;
            Model.Subcategory = expense.Subcategory;
            Model.Tags = expense.Tags;

            SelectedCategoryId = expense.CategoryGlobalId?.ToString();
            if (expense.MemberGlobalId.HasValue)
            {
                SelectedMemberId = expense.MemberGlobalId.Value.ToString();
            }

            if (expense.AccountGlobalId.HasValue)
            {
                SelectedAccountString = expense.AccountGlobalId.Value.ToString();
            }

            // Detect type of existing expense
            if (ExpenseService.IsTransferTransaction(expense))
            {
                SelectedType = "transfer";
                TransferAmount = Math.Abs(expense.Amount);
                TransferDescription = expense.Description;
                TransferDate = expense.TransactionDate;
                TransferNote = expense.Note;

                var isTransferOut = ExpenseService.IsTransferOutTransaction(expense);
                var peer = await ExpenseService.GetTransferPeerAsync(expense.GlobalId);

                if (isTransferOut)
                {
                    TransferSourceAccountId = expense.AccountGlobalId;
                    TransferDestAccountId = peer?.AccountGlobalId;
                }
                else
                {
                    TransferDestAccountId = expense.AccountGlobalId;
                    TransferSourceAccountId = peer?.AccountGlobalId;
                }

                // If peer destination/source account couldn't be resolved, check Note / Description
                if (!TransferDestAccountId.HasValue && !string.IsNullOrWhiteSpace(expense.Note))
                {
                    var matchTo = System.Text.RegularExpressions.Regex.Match(expense.Note, @"(To|destination):\s*([^)\r\n]+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                    if (matchTo.Success)
                    {
                        var destName = matchTo.Groups[2].Value.Trim();
                        var acc = AllBankAccounts.FirstOrDefault(a => string.Equals(a.AccountName, destName, StringComparison.OrdinalIgnoreCase));
                        if (acc != null) TransferDestAccountId = acc.GlobalId;
                    }
                }
                if (!TransferSourceAccountId.HasValue && !string.IsNullOrWhiteSpace(expense.Note))
                {
                    var matchFrom = System.Text.RegularExpressions.Regex.Match(expense.Note, @"(From|source):\s*([^)\r\n]+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                    if (matchFrom.Success)
                    {
                        var srcName = matchFrom.Groups[2].Value.Trim();
                        var acc = AllBankAccounts.FirstOrDefault(a => string.Equals(a.AccountName, srcName, StringComparison.OrdinalIgnoreCase));
                        if (acc != null) TransferSourceAccountId = acc.GlobalId;
                    }
                }

                if (!TransferDestAccountId.HasValue && TransferSourceAccountId.HasValue)
                {
                    var other = AvailableBankAccountsList.FirstOrDefault(a => a.GlobalId != TransferSourceAccountId.Value);
                    if (other != null) TransferDestAccountId = other.GlobalId;
                }
            }
            else if (ExpenseService.IsIncomeTransaction(expense))
            {
                SelectedType = "income";
            }
            else
            {
                SelectedType = "expense";
            }

            if (!string.IsNullOrEmpty(Model.Note) || !string.IsNullOrEmpty(Model.Subcategory) || !string.IsNullOrEmpty(Model.Tags))
            {
                ShowExtraDetails = true;
            }
        }
        else
        {
            // Pre-select accounts if provided via query or default to member's first account
            if (Guid.TryParse(QueryAccountId, out var accGuid))
            {
                var match = AllBankAccounts.FirstOrDefault(a => a.GlobalId == accGuid);
                if (match != null) SelectBankAccount(match);
            }
            else
            {
                var firstAcc = AvailableBankAccountsList.FirstOrDefault();
                if (firstAcc != null) SelectBankAccount(firstAcc);
            }

            // For transfers
            if (Guid.TryParse(QuerySourceAccountId, out var sGuid))
            {
                TransferSourceAccountId = sGuid;
                TransferSourceAccountString = sGuid.ToString();
            }
            else
            {
                var first = AvailableBankAccountsList.FirstOrDefault();
                if (first != null)
                {
                    TransferSourceAccountId = first.GlobalId;
                    TransferSourceAccountString = first.GlobalId.ToString();
                }
            }

            if (Guid.TryParse(QueryDestAccountId, out var dGuid))
            {
                TransferDestAccountId = dGuid;
            }
            else
            {
                var second = AvailableBankAccountsList.FirstOrDefault(a => a.GlobalId != TransferSourceAccountId);
                if (second != null) TransferDestAccountId = second.GlobalId;
            }
        }

        IsLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Session.IsAuthenticated && Session.CurrentUser is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("falimyAuth.setSession", Session.CurrentUser.GlobalId.ToString());
            }
            catch { }
        }
    }

    private void SetTransactionType(string type)
    {
        SelectedType = type switch
        {
            "income" => "income",
            "transfer" => "transfer",
            _ => "expense"
        };

        if (SelectedType == "income" && string.IsNullOrEmpty(Model.Subcategory))
        {
            Model.Subcategory = "Income";
        }
        else if (SelectedType == "expense" && string.Equals(Model.Subcategory, "Income", StringComparison.OrdinalIgnoreCase))
        {
            Model.Subcategory = null;
        }

        ErrorMessage = null;
    }

    private decimal GetAccountBalance(Guid accountGlobalId)
    {
        var match = AccountsWithBalances.FirstOrDefault(a => a.Account.GlobalId == accountGlobalId);
        return match?.CurrentBalance ?? 0m;
    }

    private async Task RefreshCategoriesAsync()
    {
        Categories = await ExpenseService.GetCategoriesAsync();
        var statuses = await ExpenseService.GetCategoryBudgetStatusesAsync(DateTime.Today.Year, DateTime.Today.Month);
        BudgetStatuses = statuses.ToDictionary(s => s.CategoryId);
        StateHasChanged();
    }

    private async Task RefreshAccountsAsync()
    {
        AllBankAccounts = await ExpenseService.GetBankAccountsAsync();
        AccountsWithBalances = await ExpenseService.GetBankAccountsWithBalancesAsync();
        StateHasChanged();
    }

    private void OnMemberChanged(string memberId)
    {
        SelectedMemberId = memberId;
        if (Guid.TryParse(memberId, out var mGuid))
        {
            var accountsForNewMember = AllBankAccounts.Where(a => a.MemberGlobalId == mGuid).ToList();
            if (!accountsForNewMember.Any(a => a.GlobalId == Model.AccountGlobalId))
            {
                var first = accountsForNewMember.FirstOrDefault();
                if (first != null) SelectBankAccount(first);
                else
                {
                    Model.AccountGlobalId = null;
                    SelectedAccountString = null;
                }
            }

            // Also reset transfer accounts
            var source = accountsForNewMember.FirstOrDefault();
            TransferSourceAccountId = source?.GlobalId;
            TransferSourceAccountString = source?.GlobalId.ToString();
            var dest = accountsForNewMember.FirstOrDefault(a => a.GlobalId != TransferSourceAccountId);
            TransferDestAccountId = dest?.GlobalId;
        }
    }

    private void SelectBankAccount(BankAccount acc)
    {
        Model.AccountGlobalId = acc.GlobalId;
        Model.Account = acc.AccountName;
        SelectedAccountString = acc.GlobalId.ToString();
    }

    private void OnAccountSelected()
    {
        if (Guid.TryParse(SelectedAccountString, out var g))
        {
            var acc = AllBankAccounts.FirstOrDefault(a => a.GlobalId == g);
            if (acc != null)
            {
                Model.AccountGlobalId = acc.GlobalId;
                Model.Account = acc.AccountName;
                return;
            }
        }
        Model.AccountGlobalId = null;
    }

    private void OnTransferSourceChanged()
    {
        if (Guid.TryParse(TransferSourceAccountString, out var g))
        {
            TransferSourceAccountId = g;
            if (TransferDestAccountId == g)
            {
                // Switch destination to another account
                var other = AvailableBankAccountsList.FirstOrDefault(a => a.GlobalId != g);
                TransferDestAccountId = other?.GlobalId;
            }
        }
        else
        {
            TransferSourceAccountId = null;
        }
    }

    private void AddAmount(decimal add)
    {
        Model.Amount += add;
    }

    private void ApplySuggestion(SuggestionItem s)
    {
        Model.Description = s.Text;
    }

    private async Task HandleTransferSubmit()
    {
        ErrorMessage = null;

        if (TransferAmount <= 0)
        {
            ErrorMessage = "Please enter a transfer amount greater than zero.";
            return;
        }

        if (!TransferSourceAccountId.HasValue)
        {
            ErrorMessage = "Please select the source bank account.";
            return;
        }

        if (!TransferDestAccountId.HasValue)
        {
            ErrorMessage = "Please select the destination bank account.";
            return;
        }

        if (TransferSourceAccountId == TransferDestAccountId)
        {
            ErrorMessage = "Source and Destination accounts must be different.";
            return;
        }

        // Duplicate check for transfer
        Guid? memberId = Session.CurrentUser?.Role == "Admin"
            ? (Guid.TryParse(SelectedMemberId, out var m) ? m : Session.CurrentUser?.GlobalId)
            : Session.CurrentUser?.GlobalId;

        var duplicates = await ExpenseService.FindPotentialDuplicateExpensesAsync(
            TransferAmount,
            TransferDate,
            TransferDescription,
            memberId);

        if (duplicates.Count > 0)
        {
            DetectedDuplicateExpense = duplicates.First();
            DuplicateConfirmTarget = "transfer";
            ShowDuplicateWarningModal = true;
            return;
        }

        await ExecuteTransferCoreAsync();
    }

    private async Task ExecuteTransferCoreAsync()
    {
        IsSaving = true;

        try
        {
            Guid? memberId = Session.CurrentUser?.Role == "Admin"
                ? (Guid.TryParse(SelectedMemberId, out var m) ? m : Session.CurrentUser?.GlobalId)
                : Session.CurrentUser?.GlobalId;

            if (IsEditMode && GlobalId.HasValue)
            {
                await ExpenseService.UpdateTransferAsync(
                    GlobalId.Value,
                    new ExpenseService.TransferRequest(
                        TransferAmount,
                        TransferSourceAccountId!.Value,
                        TransferDestAccountId!.Value,
                        TransferDate,
                        TransferDescription,
                        TransferNote,
                        memberId
                    ));
            }
            else
            {
                await ExpenseService.CreateTransferAsync(new ExpenseService.TransferRequest(
                    TransferAmount,
                    TransferSourceAccountId!.Value,
                    TransferDestAccountId!.Value,
                    TransferDate,
                    TransferDescription,
                    TransferNote,
                    memberId
                ));
            }

            Nav.NavigateTo("/expenses");
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to execute transfer: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task<bool> SaveExpenseCoreAsync()
    {
        ErrorMessage = null;

        if (Model.Amount <= 0)
        {
            ErrorMessage = "Please enter an amount greater than zero.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(Model.Description))
        {
            ErrorMessage = "Please enter a description for this transaction.";
            return false;
        }

        IsSaving = true;

        try
        {
            Guid? catGlobalId = Guid.TryParse(SelectedCategoryId, out var g) ? g : null;
            Guid? memberId = Session.CurrentUser?.Role == "Admin"
                ? (Guid.TryParse(SelectedMemberId, out var m) ? m : Session.CurrentUser?.GlobalId)
                : Session.CurrentUser?.GlobalId;

            // Compute tags based on mode
            string? tags = Model.Tags;
            string? subcat = Model.Subcategory;

            if (SelectedType == "income")
            {
                var tagList = (tags ?? "")
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Where(t => !t.Equals("expense", StringComparison.OrdinalIgnoreCase))
                    .ToList();

                if (!tagList.Any(t => t.Equals("income", StringComparison.OrdinalIgnoreCase)))
                    tagList.Add("income");

                tags = string.Join(",", tagList);
                if (string.IsNullOrEmpty(subcat)) subcat = "Income";
            }
            else
            {
                // Expense mode: strip "income" and "salary" from tags and subcategory
                var tagList = (tags ?? "")
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Where(t => !t.Equals("income", StringComparison.OrdinalIgnoreCase) &&
                                !t.Equals("salary", StringComparison.OrdinalIgnoreCase))
                    .ToList();

                tags = tagList.Count > 0 ? string.Join(",", tagList) : null;

                if (string.Equals(subcat, "Income", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(subcat, "Salary", StringComparison.OrdinalIgnoreCase))
                {
                    subcat = null;
                }
            }

            if (IsEditMode)
            {
                await ExpenseService.UpdateExpenseAsync(new Expense
                {
                    GlobalId = GlobalId!.Value,
                    Amount = Model.Amount,
                    Description = Model.Description.Trim(),
                    TransactionDate = Model.TransactionDate,
                    Account = Model.Account?.Trim(),
                    AccountGlobalId = Model.AccountGlobalId,
                    Note = Model.Note?.Trim(),
                    Subcategory = subcat?.Trim(),
                    Tags = tags?.Trim(),
                    CategoryGlobalId = catGlobalId,
                    MemberGlobalId = memberId
                });
            }
            else
            {
                await ExpenseService.CreateExpenseAsync(new Expense
                {
                    Amount = Model.Amount,
                    Description = Model.Description.Trim(),
                    TransactionDate = Model.TransactionDate,
                    Account = Model.Account?.Trim(),
                    AccountGlobalId = Model.AccountGlobalId,
                    Note = Model.Note?.Trim(),
                    Subcategory = subcat?.Trim(),
                    Tags = tags?.Trim(),
                    CategoryGlobalId = catGlobalId,
                    MemberGlobalId = memberId
                }, memberId);
            }

            return true;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to save transaction: {ex.Message}";
            return false;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task HandleSubmit()
    {
        ErrorMessage = null;

        if (Model.Amount <= 0)
        {
            ErrorMessage = "Please enter an amount greater than zero.";
            return;
        }

        if (string.IsNullOrWhiteSpace(Model.Description))
        {
            ErrorMessage = "Please enter a description for this transaction.";
            return;
        }

        Guid? memberId = Session.CurrentUser?.Role == "Admin"
            ? (Guid.TryParse(SelectedMemberId, out var m) ? m : Session.CurrentUser?.GlobalId)
            : Session.CurrentUser?.GlobalId;

        var duplicates = await ExpenseService.FindPotentialDuplicateExpensesAsync(
            Model.Amount,
            Model.TransactionDate,
            Model.Description.Trim(),
            memberId,
            IsEditMode ? GlobalId : null);

        if (duplicates.Count > 0)
        {
            DetectedDuplicateExpense = duplicates.First();
            DuplicateConfirmTarget = "submit";
            ShowDuplicateWarningModal = true;
            return;
        }

        await ExecuteSaveAndNavigateAsync();
    }

    private async Task ExecuteSaveAndNavigateAsync()
    {
        var ok = await SaveExpenseCoreAsync();
        if (ok)
        {
            Nav.NavigateTo("/expenses");
        }
    }

    private async Task HandleSubmitAndAddAnother()
    {
        ErrorMessage = null;

        if (Model.Amount <= 0)
        {
            ErrorMessage = "Please enter an amount greater than zero.";
            return;
        }

        if (string.IsNullOrWhiteSpace(Model.Description))
        {
            ErrorMessage = "Please enter a description for this transaction.";
            return;
        }

        Guid? memberId = Session.CurrentUser?.Role == "Admin"
            ? (Guid.TryParse(SelectedMemberId, out var m) ? m : Session.CurrentUser?.GlobalId)
            : Session.CurrentUser?.GlobalId;

        var duplicates = await ExpenseService.FindPotentialDuplicateExpensesAsync(
            Model.Amount,
            Model.TransactionDate,
            Model.Description.Trim(),
            memberId,
            IsEditMode ? GlobalId : null);

        if (duplicates.Count > 0)
        {
            DetectedDuplicateExpense = duplicates.First();
            DuplicateConfirmTarget = "submit_another";
            ShowDuplicateWarningModal = true;
            return;
        }

        await ExecuteSaveAndAddAnotherAsync();
    }

    private async Task ExecuteSaveAndAddAnotherAsync()
    {
        var ok = await SaveExpenseCoreAsync();
        if (ok)
        {
            SuccessMessage = SelectedType == "income" ? "Income saved successfully!" : "Expense saved successfully!";
            SuccessAlert = true;
            Model.Amount = 0;
            Model.Description = string.Empty;
            Model.Note = null;
            Model.Subcategory = null;
            Model.Tags = null;
            Model.TransactionDate = DateTime.Now;

            var statuses = await ExpenseService.GetCategoryBudgetStatusesAsync(DateTime.Today.Year, DateTime.Today.Month);
            BudgetStatuses = statuses.ToDictionary(s => s.CategoryId);

            await Task.Delay(2500);
            SuccessAlert = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmDuplicateAndProceedAsync()
    {
        ShowDuplicateWarningModal = false;
        var target = DuplicateConfirmTarget;
        DetectedDuplicateExpense = null;

        if (target == "submit")
        {
            await ExecuteSaveAndNavigateAsync();
        }
        else if (target == "submit_another")
        {
            await ExecuteSaveAndAddAnotherAsync();
        }
        else if (target == "transfer")
        {
            await ExecuteTransferCoreAsync();
        }
    }

    private void DismissDuplicateWarning()
    {
        ShowDuplicateWarningModal = false;
        DetectedDuplicateExpense = null;
    }
}
