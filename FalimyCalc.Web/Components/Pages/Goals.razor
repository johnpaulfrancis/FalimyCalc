@code {
    private List<FinancialGoal> GoalItems = [];
    private List<BankAccount> BankAccounts = [];
    private List<FamilyMember> FamilyMembers = [];
    private Dictionary<Guid, FamilyMember> MemberMap = [];
    private ExpenseService.GoalsSummary Summary = new(0, 0, 0, 0, 0, 0, []);

    private bool IsLoading = true;
    private bool IsSaving = false;
    private string ActiveTab = "All";
    private string? SelectedMemberId;
    private bool _showAllMembers = false;

    // Modals
    private bool ShowGoalModal = false;
    private string? GoalModalError;
    private FinancialGoal EditingGoal = new();
    private string? EditingAccountString;
    private string? EditingMemberString;

    // Contribution Modal
    private FinancialGoal? TargetGoalForContribution;
    private bool ContributionIsDeposit = true;
    private decimal ContributionAmount;
    private DateTime ContributionDate = DateTime.Today;
    private string? ContributionAccountString;
    private string? ContributionNote;
    private string? ContributionError;

    // History Modal
    private FinancialGoal? GoalForHistory;

    // Delete Modal
    private FinancialGoal? GoalToDelete;

    private readonly List<string> QuickIcons = ["🎯", "🏖️", "🚗", "🛡️", "💻", "🏠", "💍", "🎓", "📱", "🚴", "👶", "✈️"];
    private readonly List<string> QuickColours = ["#6366f1", "#10b981", "#f59e0b", "#ef4444", "#8b5cf6", "#ec4899", "#06b6d4", "#14b8a6"];

    private Guid? ActiveMemberFilter
    {
        get
        {
            if (Session.CurrentUser?.Role != "Admin")
                return Session.CurrentUser?.GlobalId;

            if (Guid.TryParse(SelectedMemberId, out var g))
                return g;

            return _showAllMembers ? null : Session.CurrentUser?.GlobalId;
        }
    }

    private IEnumerable<FinancialGoal> FilteredGoals
    {
        get
        {
            var query = GoalItems.AsEnumerable();
            if (ActiveTab == "Active") query = query.Where(g => g.Status == "Active");
            else if (ActiveTab == "Completed") query = query.Where(g => g.Status == "Completed");
            else if (ActiveTab == "Emergency") query = query.Where(g => g.Category == "Emergency Fund");
            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        FamilyMembers = await ExpenseService.GetFamilyMembersAsync();
        MemberMap = FamilyMembers.ToDictionary(m => m.GlobalId);
        _showAllMembers = false;
        BankAccounts = await ExpenseService.GetBankAccountsAsync(ActiveMemberFilter);

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        GoalItems = await ExpenseService.GetGoalsAsync(ActiveMemberFilter);
        Summary = await ExpenseService.GetGoalsSummaryAsync(ActiveMemberFilter);
        IsLoading = false;
    }

    private async Task SetViewMode(bool showAll)
    {
        _showAllMembers = showAll;
        SelectedMemberId = null;
        BankAccounts = await ExpenseService.GetBankAccountsAsync(ActiveMemberFilter);
        await LoadDataAsync();
    }

    private async Task OnMemberFilterChanged()
    {
        if (string.IsNullOrEmpty(SelectedMemberId)) _showAllMembers = true;
        else if (Guid.TryParse(SelectedMemberId, out var sg) && sg == Session.CurrentUser?.GlobalId) _showAllMembers = false;

        BankAccounts = await ExpenseService.GetBankAccountsAsync(ActiveMemberFilter);
        await LoadDataAsync();
    }

    private void SetTab(string tab)
    {
        ActiveTab = tab;
    }

    private void OpenCreateModal()
    {
        EditingGoal = new FinancialGoal
        {
            Colour = "#6366f1",
            Icon = "🎯",
            Category = "Emergency Fund",
            Status = "Active"
        };
        EditingAccountString = null;
        EditingMemberString = Session.CurrentUser?.Role == "Admin" ? SelectedMemberId : Session.CurrentUser?.GlobalId.ToString();
        GoalModalError = null;
        ShowGoalModal = true;
    }

    private void QuickStartGoal(string name, decimal target, string category, string icon, string color)
    {
        EditingGoal = new FinancialGoal
        {
            Name = name,
            TargetAmount = target,
            CurrentAmount = 0,
            Category = category,
            Icon = icon,
            Colour = color,
            Status = "Active"
        };
        EditingAccountString = null;
        EditingMemberString = Session.CurrentUser?.Role == "Admin" ? SelectedMemberId : Session.CurrentUser?.GlobalId.ToString();
        GoalModalError = null;
        ShowGoalModal = true;
    }

    private void OpenEditModal(FinancialGoal goal)
    {
        EditingGoal = new FinancialGoal
        {
            Id = goal.Id,
            GlobalId = goal.GlobalId,
            Name = goal.Name,
            TargetAmount = goal.TargetAmount,
            CurrentAmount = goal.CurrentAmount,
            TargetDate = goal.TargetDate,
            Category = goal.Category,
            Icon = goal.Icon,
            Colour = goal.Colour,
            Note = goal.Note,
            Status = goal.Status,
            MemberGlobalId = goal.MemberGlobalId,
            AccountGlobalId = goal.AccountGlobalId
        };
        EditingAccountString = goal.AccountGlobalId?.ToString();
        EditingMemberString = goal.MemberGlobalId?.ToString();
        GoalModalError = null;
        ShowGoalModal = true;
    }

    private void CloseGoalModal()
    {
        ShowGoalModal = false;
        GoalModalError = null;
    }

    private async Task SaveGoalAsync()
    {
        GoalModalError = null;
        if (string.IsNullOrWhiteSpace(EditingGoal.Name))
        {
            GoalModalError = "Please enter a name for this goal.";
            return;
        }

        if (EditingGoal.TargetAmount <= 0)
        {
            GoalModalError = "Target amount must be greater than zero.";
            return;
        }

        IsSaving = true;
        try
        {
            if (Guid.TryParse(EditingAccountString, out var aId)) EditingGoal.AccountGlobalId = aId;
            else EditingGoal.AccountGlobalId = null;

            if (Guid.TryParse(EditingMemberString, out var mId)) EditingGoal.MemberGlobalId = mId;
            else EditingGoal.MemberGlobalId = null;

            if (EditingGoal.Id == 0)
            {
                await ExpenseService.CreateGoalAsync(EditingGoal, EditingGoal.MemberGlobalId);
            }
            else
            {
                await ExpenseService.UpdateGoalAsync(EditingGoal);
            }

            ShowGoalModal = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            GoalModalError = $"Failed to save goal: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void OpenContributeModal(FinancialGoal goal, bool isDeposit)
    {
        TargetGoalForContribution = goal;
        ContributionIsDeposit = isDeposit;
        ContributionAmount = isDeposit ? 1000m : Math.Min(1000m, goal.CurrentAmount);
        ContributionDate = DateTime.Today;
        ContributionAccountString = goal.AccountGlobalId?.ToString();
        ContributionNote = null;
        ContributionError = null;
    }

    private void CloseContributionModal()
    {
        TargetGoalForContribution = null;
        ContributionError = null;
    }

    private async Task SaveContributionAsync()
    {
        ContributionError = null;
        if (ContributionAmount <= 0)
        {
            ContributionError = "Please enter an amount greater than zero.";
            return;
        }

        if (!ContributionIsDeposit && ContributionAmount > TargetGoalForContribution!.CurrentAmount)
        {
            ContributionError = $"Cannot withdraw more than current saved balance (₹{TargetGoalForContribution!.CurrentAmount:N2}).";
            return;
        }

        IsSaving = true;
        try
        {
            Guid? accId = Guid.TryParse(ContributionAccountString, out var aId) ? aId : null;

            await ExpenseService.AddGoalContributionAsync(
                TargetGoalForContribution!.GlobalId,
                ContributionAmount,
                ContributionIsDeposit ? "Deposit" : "Withdrawal",
                ContributionNote,
                accId,
                ContributionDate
            );

            CloseContributionModal();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ContributionError = $"Failed to record contribution: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task OpenHistoryModal(FinancialGoal goal)
    {
        GoalForHistory = await ExpenseService.GetGoalAsync(goal.GlobalId);
    }

    private void ConfirmDelete(FinancialGoal goal)
    {
        GoalToDelete = goal;
    }

    private async Task ExecuteDeleteGoalAsync()
    {
        if (GoalToDelete != null)
        {
            await ExpenseService.DeleteGoalAsync(GoalToDelete.GlobalId);
            GoalToDelete = null;
            await LoadDataAsync();
        }
    }
}
