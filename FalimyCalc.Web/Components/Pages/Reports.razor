@page "/reports"
@rendermode InteractiveServer
@using FalimyCalc.Data.Entities
@using FalimyCalc.Data.Services
@using FalimyCalc.Web.Services
@inject ExpenseService ExpenseService
@inject ExportService ExportService
@inject UserSessionService Session
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Reports & Analytics — FalimyCalc</PageTitle>

<!-- ── Page Header ─────────────────────────────────────────────────────────── -->
<div class="dash-header mb-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h1 class="dash-title mb-0">Reports & Analytics</h1>
            <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary fs-7 fw-semibold px-2 py-1">
                @CurrentMonthLabel
            </span>
        </div>
        <p class="dash-subtitle mt-1 mb-0">
            @(Session.CurrentUser?.Role == "Admin"
                ? "Track family spending trends, member contributions, and category breakdowns"
                : $"Track your personal spending trends and category breakdowns ({Session.CurrentUser?.Name})")
        </p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        @if (Session.CurrentUser?.Role == "Admin")
        {
            <div class="view-toggle" title="Toggle between your view and family view">
                <button type="button" class="view-toggle-btn @(!_showAllMembers && string.IsNullOrEmpty(SelectedMemberId) ? "active" : "")"
                        @onclick="() => SetViewMode(false)">
                    @Session.CurrentUser.Avatar Me
                </button>
                <button type="button" class="view-toggle-btn @(_showAllMembers && string.IsNullOrEmpty(SelectedMemberId) ? "active" : "")"
                        @onclick="() => SetViewMode(true)">
                    👨‍👩‍👧‍👦 All Family
                </button>
            </div>
        }
        <button class="btn btn-outline-success" @onclick="ExportReportToExcel" disabled="@(IsLoading || IsExporting)">
            @if (IsExporting)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                <span>Generating...</span>
            }
            else
            {
                <span>📊 Export Excel</span>
            }
        </button>
    </div>
</div>

<!-- ── Period Selector & Quick Filters ────────────────────────────────────── -->
<div class="card border-0 shadow-sm mb-4" style="background: var(--dash-surface);">
    <div class="card-body p-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <!-- Quick Presets -->
            <div class="d-flex align-items-center gap-1 flex-wrap">
                <span class="small fw-semibold text-muted me-1">Period:</span>
                <button type="button"
                        class="btn btn-sm @(IsCurrentMonthSelected ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="GoToCurrentMonth">
                    This Month
                </button>
                <button type="button"
                        class="btn btn-sm @(IsLastMonthSelected ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="GoToLastMonth">
                    Last Month
                </button>
                <button type="button"
                        class="btn btn-sm @(IsTwoMonthsAgoSelected ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="GoToTwoMonthsAgo">
                    @DateTime.Today.AddMonths(-2).ToString("MMMM")
                </button>
            </div>

            <!-- Month / Year Dropdowns & Nav Chevrons -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button class="btn btn-outline-secondary btn-sm" @onclick="GoToPreviousMonth" title="Previous Month">
                    ‹ Prev
                </button>

                <select class="form-select form-select-sm" style="width: 130px;" @bind="SelectedMonth" @bind:after="LoadReportDataAsync">
                    @for (int m = 1; m <= 12; m++)
                    {
                        var monthName = new DateTime(2000, m, 1).ToString("MMMM");
                        <option value="@m">@monthName</option>
                    }
                </select>

                <select class="form-select form-select-sm" style="width: 90px;" @bind="SelectedYear" @bind:after="LoadReportDataAsync">
                    @for (int y = DateTime.Today.Year - 2; y <= DateTime.Today.Year + 1; y++)
                    {
                        <option value="@y">@y</option>
                    }
                </select>

                <button class="btn btn-outline-secondary btn-sm" @onclick="GoToNextMonth" title="Next Month">
                    Next ›
                </button>

                <!-- Profile Dropdown (for Admin) -->
                @if (Session.CurrentUser?.Role == "Admin")
                {
                    <select class="form-select form-select-sm ms-sm-2" style="width: 160px;" @bind="SelectedMemberId" @bind:after="OnMemberFilterChanged">
                        <option value="">👨‍👩‍👧‍👦 All Family</option>
                        @foreach (var member in FamilyMembers)
                        {
                            <option value="@member.GlobalId">@member.Avatar @member.Name</option>
                        }
                    </select>
                }
            </div>
        </div>
    </div>
</div>

@if (IsLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="text-muted mt-2">Loading reports & analytics data...</p>
    </div>
}
else
{
    <!-- ── Top KPI Stat Cards ──────────────────────────────────────────────────── -->
    <div class="row g-3 mb-4">
        <!-- Total Spending -->
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 h-100 border-0 shadow-sm d-flex flex-row align-items-center gap-3">
                <div class="stat-icon-circle bg-danger bg-opacity-10 text-danger">
                    💳
                </div>
                <div>
                    <span class="text-muted small fw-semibold d-block">Total Spending</span>
                    <h3 class="mb-0 fw-bold" style="color: var(--c-rose, #f43f5e);">
                        ₹ @MonthTotal.ToString("N2")
                    </h3>
                    <span class="text-muted small" style="font-size: 0.75rem;">
                        @if (MonthOverMonthChange.HasValue)
                        {
                            <span class="@(MonthOverMonthChange.Value <= 0 ? "text-success" : "text-danger") fw-semibold">
                                @(MonthOverMonthChange.Value > 0 ? "▲ +" : "▼ ")@MonthOverMonthChange.Value.ToString("F1")%
                            </span>
                            <span> vs last month</span>
                        }
                        else
                        {
                            <span>for @CurrentMonthLabel</span>
                        }
                    </span>
                </div>
            </div>
        </div>

        <!-- Total Transactions -->
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 h-100 border-0 shadow-sm d-flex flex-row align-items-center gap-3">
                <div class="stat-icon-circle bg-info bg-opacity-10 text-info">
                    🧾
                </div>
                <div>
                    <span class="text-muted small fw-semibold d-block">Transactions</span>
                    <h3 class="mb-0 fw-bold" style="color: var(--dash-text);">
                        @TotalTransactions
                    </h3>
                    <span class="text-muted small" style="font-size: 0.75rem;">recorded expenses</span>
                </div>
            </div>
        </div>

        <!-- Daily Average Spending -->
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 h-100 border-0 shadow-sm d-flex flex-row align-items-center gap-3">
                <div class="stat-icon-circle bg-primary bg-opacity-10 text-primary">
                    📅
                </div>
                <div>
                    <span class="text-muted small fw-semibold d-block">Daily Average</span>
                    <h3 class="mb-0 fw-bold" style="color: var(--dash-text);">
                        ₹ @DailyAverage.ToString("N0")
                    </h3>
                    <span class="text-muted small" style="font-size: 0.75rem;">across @DaysCounted days</span>
                </div>
            </div>
        </div>

        <!-- Top Spending Category -->
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 h-100 border-0 shadow-sm d-flex flex-row align-items-center gap-3">
                <div class="stat-icon-circle bg-warning bg-opacity-10 text-warning">
                    🏷️
                </div>
                <div class="overflow-hidden">
                    <span class="text-muted small fw-semibold d-block">Top Category</span>
                    @if (CategorySummaries.FirstOrDefault() != null)
                    {
                        var top = CategorySummaries[0];
                        var topPct = MonthTotal > 0 ? (int)Math.Round((top.Total / MonthTotal) * 100) : 0;
                        <h4 class="mb-0 fw-bold text-truncate" style="color: var(--dash-text); font-size: 1.15rem;">
                            @top.Icon @top.Name
                        </h4>
                        <span class="text-muted small" style="font-size: 0.75rem;">
                            ₹ @top.Total.ToString("N0") (@topPct% of total)
                        </span>
                    }
                    else
                    {
                        <h4 class="mb-0 fw-bold text-muted" style="font-size: 1.15rem;">None</h4>
                        <span class="text-muted small" style="font-size: 0.75rem;">No data recorded</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ── Family Member Contributions (Admin 'All Family' view) ──────────────── -->
    @if (Session.CurrentUser?.Role == "Admin" && string.IsNullOrEmpty(SelectedMemberId) && _showAllMembers && MemberSummaries.Any())
    {
        <div class="card border-0 shadow-sm mb-4" style="background: var(--dash-surface);">
            <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-5">👨‍👩‍👧‍👦</span>
                    <h5 class="mb-0 fw-bold" style="color: var(--dash-text);">Spending by Family Member</h5>
                </div>
                <span class="small text-muted">@CurrentMonthLabel</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var mem in MemberSummaries)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="p-3 rounded-3 member-card position-relative"
                                 style="background: var(--dash-surface-raised); border: 1px solid var(--dash-border); cursor: pointer;"
                                 title="Click to filter by @mem.MemberName"
                                 @onclick="() => FilterByMember(mem.MemberGlobalId?.ToString())">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge rounded-pill fs-6 p-2" style="background-color: @mem.Colour; color: white;">
                                            @mem.Avatar
                                        </span>
                                        <div>
                                            <h6 class="mb-0 fw-bold" style="color: var(--dash-text);">@mem.MemberName</h6>
                                            <span class="small text-muted">@mem.Count transactions</span>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold fs-6" style="color: var(--c-rose, #f43f5e);">
                                            ₹ @mem.Total.ToString("N0")
                                        </div>
                                        <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary small">
                                            @mem.Percentage%
                                        </span>
                                    </div>
                                </div>
                                <!-- Member progress bar -->
                                <div class="progress" style="height: 6px; border-radius: 3px; background: var(--dash-border);">
                                    <div class="progress-bar" style="width: @mem.Percentage%; background-color: @mem.Colour;"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- ── Category Breakdown & Spending Trend Row ─────────────────────────────── -->
    <div class="row g-4 mb-4">
        <!-- Category Breakdown -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100" style="background: var(--dash-surface);">
                <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fs-5">📊</span>
                        <h5 class="mb-0 fw-bold" style="color: var(--dash-text);">Category Breakdown</h5>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <select class="form-select form-select-sm" style="width: 140px;" @bind="CategorySortBy">
                            <option value="amount_desc">Amount (High)</option>
                            <option value="count_desc">Transactions</option>
                            <option value="name_asc">Name (A → Z)</option>
                        </select>
                    </div>
                </div>
                <div class="card-body">
                    @if (!SortedCategorySummaries.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <span class="fs-1 d-block mb-2">📁</span>
                            <p class="mb-0">No expenses recorded for @CurrentMonthLabel.</p>
                        </div>
                    }
                    else
                    {
                        <!-- Segmented Distribution Bar -->
                        <div class="progress mb-4" style="height: 12px; border-radius: 6px; overflow: hidden; background: var(--dash-surface-raised);">
                            @foreach (var cat in CategorySummaries.Take(6))
                            {
                                var pct = MonthTotal > 0 ? (double)(cat.Total / MonthTotal * 100) : 0;
                                <div class="progress-bar"
                                     style="width: @pct%; background-color: @(cat.Colour ?? "#6366f1");"
                                     title="@cat.Name: @pct.ToString("F1")%">
                                </div>
                            }
                        </div>

                        <!-- Categories Table -->
                        <div class="table-responsive">
                            <table class="table align-middle mb-0" style="color: var(--dash-text);">
                                <thead>
                                    <tr class="small text-muted border-bottom" style="border-color: var(--dash-border) !important;">
                                        <th>Category</th>
                                        <th class="text-center">Count</th>
                                        <th style="width: 32%;">Distribution</th>
                                        <th class="text-end">Amount</th>
                                        <th class="text-end" style="width: 45px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cat in SortedCategorySummaries)
                                    {
                                        var pct = MonthTotal > 0 ? (int)Math.Round((cat.Total / MonthTotal) * 100) : 0;
                                        <tr class="border-bottom" style="border-color: var(--dash-border) !important;">
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge rounded-pill px-2 py-1"
                                                          style="background-color: @(cat.Colour ?? "#6366f1")20; color: @(cat.Colour ?? "#6366f1"); border: 1px solid @(cat.Colour ?? "#6366f1")40;">
                                                        @cat.Icon @cat.Name
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="text-center small text-muted">
                                                @cat.Count
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="progress flex-grow-1" style="height: 7px; border-radius: 3px; background: var(--dash-surface-raised);">
                                                        <div class="progress-bar"
                                                             style="width: @pct%; background-color: @(cat.Colour ?? "#6366f1");"></div>
                                                    </div>
                                                    <span class="small text-muted" style="min-width: 35px; font-size: 0.75rem;">@pct%</span>
                                                </div>
                                            </td>
                                            <td class="text-end fw-bold" style="font-variant-numeric: tabular-nums;">
                                                ₹ @cat.Total.ToString("N2")
                                            </td>
                                            <td class="text-end">
                                                @if (cat.CategoryGlobalId.HasValue)
                                                {
                                                    <a href="/expenses?categoryId=@cat.CategoryGlobalId.Value"
                                                       class="btn btn-outline-secondary btn-sm p-1 px-2 border-0"
                                                       title="View expenses for @cat.Name">
                                                        🔎
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 6-Month Spending Trend -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100" style="background: var(--dash-surface);">
                <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fs-5">📈</span>
                        <h5 class="mb-0 fw-bold" style="color: var(--dash-text);">6-Month Spending Trend</h5>
                    </div>
                    @if (Trends.Any())
                    {
                        var sixMonthAvg = Trends.Average(t => t.Total);
                        <span class="small text-muted">Avg: <strong>₹ @sixMonthAvg.ToString("N0")</strong></span>
                    }
                </div>
                <div class="card-body">
                    @if (!Trends.Any())
                    {
                        <p class="text-muted text-center py-5">No trend data available.</p>
                    }
                    else
                    {
                        var maxTrend = Trends.Max(t => t.Total);
                        if (maxTrend == 0) maxTrend = 1;

                        <div class="d-flex flex-column gap-3">
                            @foreach (var trend in Trends)
                            {
                                var pct = (int)Math.Round((trend.Total / maxTrend) * 100);
                                var isSelected = trend.Year == SelectedYear && trend.Month == SelectedMonth;

                                <div class="p-2 px-3 rounded-3 trend-row @(isSelected ? "trend-row--active" : "")"
                                     style="background: var(--dash-surface-raised); border: 1px solid @(isSelected ? "var(--c-indigo, #6366f1)" : "var(--dash-border)"); cursor: pointer;"
                                     @onclick="() => SelectPeriod(trend.Year, trend.Month)">
                                    <div class="d-flex justify-content-between small mb-1 align-items-center">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-semibold @(isSelected ? "text-primary fw-bold" : "")" style="color: var(--dash-text);">
                                                @trend.MonthName
                                            </span>
                                            @if (isSelected)
                                            {
                                                <span class="badge bg-primary text-white" style="font-size: 0.65rem;">Active</span>
                                            }
                                        </div>
                                        <span class="fw-bold fs-6" style="color: var(--c-rose, #f43f5e); font-variant-numeric: tabular-nums;">
                                            ₹ @trend.Total.ToString("N2")
                                        </span>
                                    </div>
                                    <div class="progress" style="height: 8px; border-radius: 4px; background: var(--dash-border);">
                                        <div class="progress-bar @(isSelected ? "bg-primary" : "bg-secondary")"
                                             style="width: @pct%; transition: width 0.3s ease;"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<style>
    .member-card:hover {
        border-color: var(--dash-primary) !important;
        transform: translateY(-2px);
        transition: transform 0.15s ease, border-color 0.15s ease;
    }
    .trend-row:hover {
        background: var(--dash-surface) !important;
        transform: translateX(2px);
        transition: transform 0.12s ease;
    }
    .trend-row--active {
        box-shadow: 0 0 0 1px var(--c-indigo, #6366f1);
    }
    .stat-icon-circle {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
    }
</style>

@code {
    private int SelectedMonth = DateTime.Today.Month;
    private int SelectedYear = DateTime.Today.Year;
    private bool IsLoading = true;

    private decimal MonthTotal = 0;
    private int TotalTransactions = 0;
    private List<ExpenseService.CategorySummaryItem> CategorySummaries = [];
    private List<ExpenseService.MonthlyTrendItem> Trends = [];
    private List<FamilyMember> FamilyMembers = [];
    private List<ExpenseService.MemberSpendingSummaryItem> MemberSummaries = [];

    private bool _showAllMembers = false;
    private string? SelectedMemberId;
    private string CategorySortBy = "amount_desc";

    private bool IsCurrentMonthSelected => SelectedYear == DateTime.Today.Year && SelectedMonth == DateTime.Today.Month;
    private bool IsLastMonthSelected
    {
        get
        {
            var lm = DateTime.Today.AddMonths(-1);
            return SelectedYear == lm.Year && SelectedMonth == lm.Month;
        }
    }
    private bool IsTwoMonthsAgoSelected
    {
        get
        {
            var tm = DateTime.Today.AddMonths(-2);
            return SelectedYear == tm.Year && SelectedMonth == tm.Month;
        }
    }

    private Guid? ActiveMemberFilter
    {
        get
        {
            if (Session.CurrentUser?.Role != "Admin")
                return Session.CurrentUser?.GlobalId;

            if (Guid.TryParse(SelectedMemberId, out var g))
                return g;

            return _showAllMembers ? null : Session.CurrentUser?.GlobalId;
        }
    }

    private string CurrentMonthLabel => new DateTime(SelectedYear, SelectedMonth, 1).ToString("MMMM yyyy");

    private int DaysCounted
    {
        get
        {
            if (IsCurrentMonthSelected)
                return Math.Max(1, DateTime.Today.Day);

            return DateTime.DaysInMonth(SelectedYear, SelectedMonth);
        }
    }

    private decimal DailyAverage => DaysCounted > 0 ? MonthTotal / DaysCounted : 0m;

    private double? MonthOverMonthChange
    {
        get
        {
            if (!Trends.Any()) return null;

            var currentIdx = Trends.FindIndex(t => t.Year == SelectedYear && t.Month == SelectedMonth);
            if (currentIdx > 0)
            {
                var prevTotal = Trends[currentIdx - 1].Total;
                if (prevTotal > 0)
                {
                    return (double)((MonthTotal - prevTotal) / prevTotal * 100m);
                }
            }
            return null;
        }
    }

    private IEnumerable<ExpenseService.CategorySummaryItem> SortedCategorySummaries
    {
        get
        {
            return CategorySortBy switch
            {
                "count_desc" => CategorySummaries.OrderByDescending(c => c.Count),
                "name_asc" => CategorySummaries.OrderBy(c => c.Name),
                _ => CategorySummaries.OrderByDescending(c => c.Total)
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        FamilyMembers = await ExpenseService.GetFamilyMembersAsync();
        _showAllMembers = false;
        await LoadReportDataAsync();
    }

    private async Task SetViewMode(bool showAll)
    {
        _showAllMembers = showAll;
        SelectedMemberId = null;
        await LoadReportDataAsync();
    }

    private async Task OnMemberFilterChanged()
    {
        if (string.IsNullOrEmpty(SelectedMemberId))
        {
            _showAllMembers = true;
        }
        else if (Guid.TryParse(SelectedMemberId, out var sg) && sg == Session.CurrentUser?.GlobalId)
        {
            _showAllMembers = false;
        }
        await LoadReportDataAsync();
    }

    private async Task FilterByMember(string? memberId)
    {
        SelectedMemberId = memberId;
        await OnMemberFilterChanged();
    }

    private async Task SelectPeriod(int year, int month)
    {
        SelectedYear = year;
        SelectedMonth = month;
        await LoadReportDataAsync();
    }

    private async Task LoadReportDataAsync()
    {
        IsLoading = true;
        var filter = ActiveMemberFilter;

        MonthTotal = await ExpenseService.GetMonthlyTotalAsync(SelectedYear, SelectedMonth, filter);
        CategorySummaries = await ExpenseService.GetDetailedCategorySummaryAsync(SelectedYear, SelectedMonth, filter);
        TotalTransactions = CategorySummaries.Sum(c => c.Count);

        Trends = await ExpenseService.GetSpendingTrendsAsync(6, filter);

        if (Session.CurrentUser?.Role == "Admin")
        {
            MemberSummaries = await ExpenseService.GetMemberSpendingSummaryAsync(SelectedYear, SelectedMonth);
        }

        IsLoading = false;
    }

    private async Task GoToPreviousMonth()
    {
        var dt = new DateTime(SelectedYear, SelectedMonth, 1).AddMonths(-1);
        SelectedYear = dt.Year;
        SelectedMonth = dt.Month;
        await LoadReportDataAsync();
    }

    private async Task GoToNextMonth()
    {
        var dt = new DateTime(SelectedYear, SelectedMonth, 1).AddMonths(1);
        SelectedYear = dt.Year;
        SelectedMonth = dt.Month;
        await LoadReportDataAsync();
    }

    private async Task GoToCurrentMonth()
    {
        SelectedYear = DateTime.Today.Year;
        SelectedMonth = DateTime.Today.Month;
        await LoadReportDataAsync();
    }

    private async Task GoToLastMonth()
    {
        var lm = DateTime.Today.AddMonths(-1);
        SelectedYear = lm.Year;
        SelectedMonth = lm.Month;
        await LoadReportDataAsync();
    }

    private async Task GoToTwoMonthsAgo()
    {
        var tm = DateTime.Today.AddMonths(-2);
        SelectedYear = tm.Year;
        SelectedMonth = tm.Month;
        await LoadReportDataAsync();
    }

    private bool IsExporting = false;

    private async Task ExportReportToExcel()
    {
        try
        {
            IsExporting = true;
            StateHasChanged();

            var bytes = ExportService.ExportReportToExcel(
                CurrentMonthLabel,
                MonthTotal,
                TotalTransactions,
                CategorySummaries,
                Trends);

            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"Spending_Report_{SelectedYear}_{SelectedMonth:D2}.xlsx";

            await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64);
        }
        finally
        {
            IsExporting = false;
            StateHasChanged();
        }
    }
}
