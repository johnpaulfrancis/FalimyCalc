@page "/"
@rendermode InteractiveServer
@using FalimyCalc.Data.Entities
@using FalimyCalc.Data.Services
@using FalimyCalc.Web.Services
@inject ExpenseService ExpenseService
@inject UserSessionService Session

<PageTitle>Dashboard — FalimyCalc</PageTitle>

@* ── Header ──────────────────────────────────────────────────────── *@
<div class="dash-header">
    <div>
        <h1 class="dash-title">FalimyCalc</h1>
        <p class="dash-subtitle">@_greeting, @DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
    </div>
    <div class="dash-header-actions d-flex align-items-center gap-2 flex-wrap">

        @* Admin view-mode toggle *@
        @if (Session.CurrentUser?.Role == "Admin")
        {
            <div class="view-toggle" title="Toggle between your view and family view">
                <button class="view-toggle-btn @(!_showAllMembers && string.IsNullOrEmpty(SelectedMemberId) ? "active" : "")"
                        @onclick="() => SetViewMode(false)">
                    @Session.CurrentUser.Avatar Me
                </button>
                <button class="view-toggle-btn @(_showAllMembers && string.IsNullOrEmpty(SelectedMemberId) ? "active" : "")"
                        @onclick="() => SetViewMode(true)">
                    👨‍👩‍👧‍👦 Family
                </button>
            </div>
            <select class="form-select form-select-sm" style="width: auto;" @bind="SelectedMemberId" @bind:after="OnMemberFilterChanged">
                <option value="">All Profiles</option>
                @foreach (var member in FamilyMembers)
                {
                    <option value="@member.GlobalId">@member.Avatar @member.Name</option>
                }
            </select>
        }

        @if (_pendingCount > 0)
        {
            <a href="/pending" class="btn btn-warning d-inline-flex align-items-center gap-1 rounded-pill px-3 fw-semibold shadow-sm">
                <span>📥</span> Review Pending (@_pendingCount)
            </a>
        }
        <a href="/expenses/add?type=income" class="btn btn-outline-success d-inline-flex align-items-center gap-1 shadow-sm">
            <span>📈</span> <span>Income</span>
        </a>
        <a href="/expenses/add?type=transfer" class="btn btn-outline-primary d-inline-flex align-items-center gap-1 shadow-sm">
            <span>🔁</span> <span>Transfer</span>
        </a>
        <a href="/expenses/add?type=expense" class="btn-primary-glow">
            <span class="btn-icon">＋</span> Add Expense
        </a>
    </div>
</div>

@* View context label *@
@if (Session.CurrentUser?.Role == "Admin")
{
    <div class="view-context-label">
        @if (!string.IsNullOrEmpty(SelectedMemberId) && Guid.TryParse(SelectedMemberId, out var sg) && MemberMap.TryGetValue(sg, out var sm))
        {
            <span>@sm.Avatar Showing transactions for <strong>@sm.Name</strong></span>
        }
        else if (_showAllMembers)
        {
            <span>👨‍👩‍👧‍👦 Showing <strong>all family</strong> transactions</span>
        }
        else
        {
            <span>@Session.CurrentUser.Avatar Showing only <strong>your (@Session.CurrentUser.Name)</strong> transactions</span>
        }
    </div>
}

@if (IsLoading)
{
    <div class="skeleton-wrapper">
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
    </div>
}
else
{
    @* ── Alerts ───────────────────────────────────────────────────── *@
    @if (_spendingAlerts.Any())
    {
        <div class="alerts-row">
            @foreach (var alert in _spendingAlerts)
            {
                <div class="dash-alert dash-alert--@alert.Severity">
                    <span class="alert-icon">@alert.Icon</span>
                    <span class="alert-text">@alert.Message</span>
                </div>
            }
        </div>
    }

    <!-- ── AI Financial Advice Snapshot Banner ─────────────────────── -->
    <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.08) 0%, rgba(6, 182, 212, 0.08) 100%); border: 1px solid rgba(99, 102, 241, 0.25) !important; border-radius: 14px;">
        <div class="card-body p-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                <span class="fs-3">✨</span>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <strong class="text-primary small text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">AI Financial Advisor & Health Analyzer</strong>
                        <span class="badge rounded-pill bg-primary text-white" style="font-size: 0.65rem;">Smart Diagnostics</span>
                    </div>
                    <div class="small fw-semibold mt-1" style="color: var(--dash-text);">
                        Personalized advice, 50/30/20 budget breakdown, and predictive goal milestones available for your profile.
                    </div>
                </div>
            </div>
            <a href="/ai-advisor" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold shadow-sm d-flex align-items-center gap-1">
                <span>🤖</span> <span>View Profile Advice →</span>
            </a>
        </div>
    </div>

    @* ── Financial Overview KPIs ────────────────────────────────────── *@
    <div class="row g-3 mb-4">
        <!-- 1. Net Total Balance -->
        <div class="col-sm-6 col-xl-3">
            <div class="card p-3 h-100 border-0 shadow-sm kpi-card-financial" style="background: var(--dash-surface); border: 1px solid var(--dash-border) !important; border-radius: 14px;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-semibold text-muted text-uppercase" style="font-size: 0.72rem;">Net Total Balance</span>
                    <span class="fs-5">🏦</span>
                </div>
                <h3 class="mb-1 fw-bold @((_financialSummary?.TotalNetBalance ?? 0) >= 0 ? "text-success" : "text-danger")" style="font-variant-numeric: tabular-nums;">
                    ₹ @(_financialSummary?.TotalNetBalance.ToString("N2") ?? "0.00")
                </h3>
                <div class="d-flex align-items-center justify-content-between mt-auto pt-2 border-top" style="border-color: var(--dash-border) !important;">
                    <span class="badge @((_financialSummary?.TotalNetBalance ?? 0) >= 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")" style="font-size: 0.7rem;">
                        @((_financialSummary?.TotalNetBalance ?? 0) >= 0 ? "✅ Net Positive" : "🚨 Overdrawn")
                    </span>
                    <span class="text-muted small" style="font-size: 0.75rem;">
                        @(_financialSummary?.ActiveAccountsCount ?? 0) active accounts
                    </span>
                </div>
            </div>
        </div>

        <!-- 2. Current Month Expense -->
        <div class="col-sm-6 col-xl-3">
            <div class="card p-3 h-100 border-0 shadow-sm kpi-card-financial" style="background: var(--dash-surface); border: 1px solid var(--dash-border) !important; border-radius: 14px;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-semibold text-muted text-uppercase" style="font-size: 0.72rem;">Current Month Outflow</span>
                    <span class="fs-5">💸</span>
                </div>
                <h3 class="mb-1 fw-bold" style="color: var(--c-rose, #f43f5e); font-variant-numeric: tabular-nums;">
                    ₹ @(_financialSummary?.CurrentMonthExpense.ToString("N2") ?? MonthlyTotal.ToString("N2"))
                </h3>
                <div class="d-flex align-items-center justify-content-between mt-auto pt-2 border-top" style="border-color: var(--dash-border) !important;">
                    <span class="text-muted small" style="font-size: 0.75rem;">
                        Burn: <strong>₹ @(_financialSummary?.DailyBurnRate.ToString("N0") ?? _dailyAvg.ToString("N0"))/day</strong>
                    </span>
                    <span class="badge bg-danger-subtle text-danger" style="font-size: 0.7rem;">
                        Total Spent
                    </span>
                </div>
            </div>
        </div>

        <!-- 3. Current Month Income -->
        <div class="col-sm-6 col-xl-3">
            <div class="card p-3 h-100 border-0 shadow-sm kpi-card-financial" style="background: var(--dash-surface); border: 1px solid var(--dash-border) !important; border-radius: 14px;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-semibold text-muted text-uppercase" style="font-size: 0.72rem;">Current Month Inflow</span>
                    <span class="fs-5">📈</span>
                </div>
                <h3 class="mb-1 fw-bold text-success" style="font-variant-numeric: tabular-nums;">
                    ₹ @(_financialSummary?.CurrentMonthIncome.ToString("N2") ?? "0.00")
                </h3>
                <div class="d-flex align-items-center justify-content-between mt-auto pt-2 border-top" style="border-color: var(--dash-border) !important;">
                    <span class="text-muted small" style="font-size: 0.75rem;">
                        Income & Credits
                    </span>
                    <span class="badge bg-success-subtle text-success" style="font-size: 0.7rem;">
                        Deposits
                    </span>
                </div>
            </div>
        </div>

        <!-- 4. Net Monthly Cash Flow / Savings -->
        <div class="col-sm-6 col-xl-3">
            <div class="card p-3 h-100 border-0 shadow-sm kpi-card-financial" style="background: var(--dash-surface); border: 1px solid var(--dash-border) !important; border-radius: 14px;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-semibold text-muted text-uppercase" style="font-size: 0.72rem;">Net Cash Flow / Savings</span>
                    <span class="fs-5">💰</span>
                </div>
                <h3 class="mb-1 fw-bold @((_financialSummary?.NetMonthlyCashFlow ?? 0) >= 0 ? "text-success" : "text-danger")" style="font-variant-numeric: tabular-nums;">
                    ₹ @(_financialSummary?.NetMonthlyCashFlow.ToString("N2") ?? "0.00")
                </h3>
                <div class="d-flex align-items-center justify-content-between mt-auto pt-2 border-top" style="border-color: var(--dash-border) !important;">
                    <span class="text-muted small" style="font-size: 0.75rem;">
                        Savings: <strong>@(_financialSummary?.SavingsRate.ToString("F1") ?? "0.0")%</strong>
                    </span>
                    <span class="badge @((_financialSummary?.NetMonthlyCashFlow ?? 0) >= 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")" style="font-size: 0.7rem;">
                        @((_financialSummary?.NetMonthlyCashFlow ?? 0) >= 0 ? "Surplus" : "Deficit")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Balance Amount Line Chart ───────────────────────────────────── -->
    <div class="card border-0 shadow-sm mb-4" style="background: var(--dash-surface); border: 1px solid var(--dash-border) !important; border-radius: 14px;">
        <div class="card-header bg-transparent py-3 d-flex align-items-center justify-content-between flex-wrap gap-2 border-bottom" style="border-color: var(--dash-border) !important;">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">📈</span>
                <div>
                    <h5 class="mb-0 fw-bold" style="color: var(--dash-text);">Balance Trend</h5>
                    <span class="text-muted small">Daily net available funds across bank accounts</span>
                </div>
            </div>

            <!-- Period Switcher & Live Inspector Pill -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                @if (_hoveredBalancePoint != null)
                {
                    <div class="d-flex align-items-center gap-2 px-3 py-1 rounded-pill animate-in"
                         style="background: var(--dash-surface-raised); border: 1px solid var(--dash-border); font-size: 0.8rem;">
                        <span class="text-muted">@_hoveredBalancePoint.DateLabel:</span>
                        <strong class="@(_hoveredBalancePoint.Balance >= 0 ? "text-success" : "text-danger")">
                            ₹ @_hoveredBalancePoint.Balance.ToString("N2")
                        </strong>
                        @if (_hoveredBalancePoint.DailyExpense > 0)
                        {
                            <span class="text-danger small ms-1">(-₹@_hoveredBalancePoint.DailyExpense.ToString("N0"))</span>
                        }
                    </div>
                }

                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn @(_trendDays == DateTime.Now.Day ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => SetTrendDays(DateTime.Now.Day)">
                        📅 This Month
                    </button>
                    <button type="button" class="btn @(_trendDays == 30 ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => SetTrendDays(30)">
                        🗓️ Last 30 Days
                    </button>
                    <button type="button" class="btn @(_trendDays == 60 ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => SetTrendDays(60)">
                        60 Days
                    </button>
                </div>
            </div>
        </div>

        <div class="card-body p-3">
            @if (_financialSummary == null || !_financialSummary.BalanceHistory.Any())
            {
                <div class="text-center py-5 text-muted">
                    <span class="fs-1 d-block mb-2">📊</span>
                    <p class="mb-0">No balance history recorded yet. Configure your bank accounts to see the live trend.</p>
                </div>
            }
            else
            {
                var (linePath, areaPath, points, minBal, maxBal, zeroY) = ComputeSvgChart();

                <!-- High/Low KPI ribbon -->
                <div class="row g-2 text-center mb-3">
                    <div class="col-6 col-md-3">
                        <div class="p-2 rounded-2" style="background: var(--dash-surface-raised); border: 1px solid var(--dash-border);">
                            <span class="text-muted small d-block" style="font-size: 0.72rem;">STARTING BALANCE</span>
                            <span class="fw-bold small" style="color: var(--dash-text);">
                                ₹ @(_financialSummary.BalanceHistory.First().Balance.ToString("N2"))
                            </span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-2 rounded-2" style="background: var(--dash-surface-raised); border: 1px solid var(--dash-border);">
                            <span class="text-muted small d-block" style="font-size: 0.72rem;">CURRENT BALANCE</span>
                            <span class="fw-bold small @(_financialSummary.TotalNetBalance >= 0 ? "text-success" : "text-danger")">
                                ₹ @(_financialSummary.TotalNetBalance.ToString("N2"))
                            </span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-2 rounded-2" style="background: var(--dash-surface-raised); border: 1px solid var(--dash-border);">
                            <span class="text-muted small d-block" style="font-size: 0.72rem;">PEAK BALANCE</span>
                            <span class="fw-bold small text-success">
                                ₹ @maxBal.ToString("N2")
                            </span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-2 rounded-2" style="background: var(--dash-surface-raised); border: 1px solid var(--dash-border);">
                            <span class="text-muted small d-block" style="font-size: 0.72rem;">LOWEST BALANCE</span>
                            <span class="fw-bold small @(minBal < 0 ? "text-danger" : "text-muted")">
                                ₹ @minBal.ToString("N2")
                            </span>
                        </div>
                    </div>
                </div>

                <!-- SVG Line Chart Canvas -->
                <div class="position-relative w-100 overflow-hidden" style="min-height: 200px;">
                    <svg viewBox="0 0 650 200" preserveAspectRatio="none" style="width: 100%; height: 210px; display: block;">
                        <defs>
                            <linearGradient id="balanceAreaGrad" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="var(--c-indigo, #6366f1)" stop-opacity="0.32" />
                                <stop offset="100%" stop-color="var(--c-indigo, #6366f1)" stop-opacity="0.0" />
                            </linearGradient>
                        </defs>

                        <!-- Background horizontal grid lines -->
                        <line x1="65" y1="20" x2="630" y2="20" stroke="var(--dash-border)" stroke-dasharray="3,3" stroke-width="1" />
                        <line x1="65" y1="92" x2="630" y2="92" stroke="var(--dash-border)" stroke-dasharray="3,3" stroke-width="1" />
                        <line x1="65" y1="165" x2="630" y2="165" stroke="var(--dash-border)" stroke-width="1" />

                        <!-- Zero reference line if within bounds -->
                        @if (zeroY >= 20 && zeroY <= 165)
                        {
                            <line x1="65" y1="@zeroY.ToString("F1")" x2="630" y2="@zeroY.ToString("F1")" stroke="var(--c-rose, #f43f5e)" stroke-dasharray="4,4" stroke-width="1.2" />
                            @((MarkupString)$"<text x=\"58\" y=\"{(zeroY + 3):F1}\" text-anchor=\"end\" fill=\"var(--c-rose, #f43f5e)\" font-size=\"9\" font-weight=\"600\">₹0</text>")
                        }

                        <!-- Y-axis Labels -->
                        <text x="58" y="24" text-anchor="end" fill="var(--dash-text-muted)" font-size="10" font-family="var(--font-main)">₹@FormatK(maxBal)</text>
                        <text x="58" y="96" text-anchor="end" fill="var(--dash-text-muted)" font-size="10" font-family="var(--font-main)">₹@FormatK((maxBal + minBal) / 2m)</text>
                        <text x="58" y="168" text-anchor="end" fill="var(--dash-text-muted)" font-size="10" font-family="var(--font-main)">₹@FormatK(minBal)</text>

                        <!-- Area Fill -->
                        @if (!string.IsNullOrEmpty(areaPath))
                        {
                            <path d="@areaPath" fill="url(#balanceAreaGrad)" />
                        }

                        <!-- The Balance Line -->
                        @if (!string.IsNullOrEmpty(linePath))
                        {
                            <path d="@linePath" fill="none" stroke="var(--c-indigo, #6366f1)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                        }

                        <!-- Data Points with hover and click -->
                        @foreach (var p in points)
                        {
                            var isSelected = _hoveredBalancePoint != null && _hoveredBalancePoint.Date.Date == p.pt.Date.Date;
                            <circle cx="@p.x.ToString("F1")"
                                    cy="@p.y.ToString("F1")"
                                    r="@(isSelected ? "6" : "3.5")"
                                    fill="@(isSelected ? "var(--c-indigo, #6366f1)" : "var(--dash-surface)")"
                                    stroke="var(--c-indigo, #6366f1)"
                                    stroke-width="@(isSelected ? "3" : "2")"
                                    style="cursor: pointer; transition: all 0.15s ease;"
                                    @onmouseover="() => _hoveredBalancePoint = p.pt"
                                    @onclick="() => _hoveredBalancePoint = p.pt">
                                <title>@p.pt.DateLabel: Balance ₹@p.pt.Balance.ToString("N2") @(p.pt.DailyExpense > 0 ? $"(-₹{p.pt.DailyExpense:N0})" : "")</title>
                            </circle>
                        }

                        <!-- X-axis Date Labels (Sampled evenly) -->
                        @{
                            int sampleStep = Math.Max(1, (points.Count - 1) / 5);
                            var sampledIndices = new HashSet<int>();
                            for (int i = 0; i < points.Count; i += sampleStep)
                            {
                                sampledIndices.Add(i);
                            }
                            sampledIndices.Add(points.Count - 1); // Always include the last day
                        }
                        @foreach (var idx in sampledIndices.OrderBy(i => i))
                        {
                            if (idx < points.Count)
                            {
                                var pt = points[idx];
                                @((MarkupString)$"<text x=\"{pt.x:F1}\" y=\"190\" text-anchor=\"middle\" fill=\"var(--dash-text-muted)\" font-size=\"10\" font-family=\"var(--font-main)\">{pt.pt.DateLabel}</text>")
                            }
                        }
                    </svg>
                </div>
            }
        </div>
    </div>

    <!-- ── Current Month Expense & Income Cash Flow Timeline ──────────── -->
    <div class="card border-0 shadow-sm mb-4" style="background: var(--dash-surface); border: 1px solid var(--dash-border) !important; border-radius: 14px;">
        <div class="card-header bg-transparent py-3 d-flex align-items-center justify-content-between flex-wrap gap-2 border-bottom" style="border-color: var(--dash-border) !important;">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">⏱️</span>
                <div>
                    <h5 class="mb-0 fw-bold" style="color: var(--dash-text);">Current Month Cash Flow & Timeline</h5>
                    <span class="small text-muted">@DateTime.Now.ToString("MMMM yyyy") cash flow progression and burn rate</span>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-secondary-subtle text-secondary small">
                    Day @(_financialSummary?.DaysElapsed ?? 1) of @(_financialSummary?.DaysInMonth ?? 30) (@((int)Math.Round((double)(_financialSummary?.DaysElapsed ?? 1) / (_financialSummary?.DaysInMonth ?? 30) * 100))%)
                </span>
            </div>
        </div>
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <!-- Visual Inflow vs Outflow Progress -->
                <div class="col-lg-7">
                    <div class="d-flex justify-content-between align-items-center mb-1 small">
                        <span class="fw-semibold text-success">
                            📈 Income: ₹@(_financialSummary?.CurrentMonthIncome.ToString("N2") ?? "0.00")
                        </span>
                        <span class="fw-semibold" style="color: var(--c-rose, #f43f5e);">
                            💸 Expenses: ₹@(_financialSummary?.CurrentMonthExpense.ToString("N2") ?? "0.00")
                        </span>
                    </div>

                    <!-- Comparative Progress Bar -->
                    @{
                        var incomeVal = (double)(_financialSummary?.CurrentMonthIncome ?? 0m);
                        var expenseVal = (double)(_financialSummary?.CurrentMonthExpense ?? 0m);
                        var maxFlow = Math.Max(incomeVal, Math.Max(expenseVal, 1.0));
                        var expPct = (int)Math.Min(100, Math.Round((expenseVal / maxFlow) * 100));
                        var incPct = (int)Math.Min(100, Math.Round((incomeVal / maxFlow) * 100));
                    }
                    <div class="progress mb-2" style="height: 12px; border-radius: 6px; background: var(--dash-surface-raised);">
                        @if (incomeVal > 0)
                        {
                            <div class="progress-bar bg-success" style="width: @incPct%;" title="Income: ₹@incomeVal.ToString("N2")"></div>
                        }
                    </div>
                    <div class="progress mb-3" style="height: 12px; border-radius: 6px; background: var(--dash-surface-raised);">
                        <div class="progress-bar bg-danger" style="width: @expPct%; background-color: var(--c-rose, #f43f5e) !important;" title="Expenses: ₹@expenseVal.ToString("N2")"></div>
                    </div>

                    <!-- Month Timeline Elapsed Bar -->
                    @{
                        var elapsedPct = (int)Math.Round((double)(_financialSummary?.DaysElapsed ?? 1) / (_financialSummary?.DaysInMonth ?? 30) * 100);
                        var remainingDays = (_financialSummary?.DaysInMonth ?? 30) - (_financialSummary?.DaysElapsed ?? 1);
                    }
                    <div class="d-flex justify-content-between align-items-center mb-1 small text-muted">
                        <span>Month Timeline Progress</span>
                        <span>@elapsedPct% elapsed (@remainingDays day@(remainingDays == 1 ? "" : "s") remaining)</span>
                    </div>
                    <div class="progress" style="height: 6px; border-radius: 3px; background: var(--dash-surface-raised);">
                        <div class="progress-bar bg-primary" style="width: @elapsedPct%;"></div>
                    </div>
                </div>

                <!-- Stats Summary Columns -->
                <div class="col-lg-5">
                    <div class="p-3 rounded-3" style="background: var(--dash-surface-raised); border: 1px solid var(--dash-border);">
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom" style="border-color: var(--dash-border) !important;">
                            <span class="small text-muted">Daily Burn Rate:</span>
                            <strong style="color: var(--dash-text);">₹ @(_financialSummary?.DailyBurnRate.ToString("N0") ?? "0") / day</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom" style="border-color: var(--dash-border) !important;">
                            <span class="small text-muted">Projected Month-End Spend:</span>
