                            <span class="fw-bold @((_financialSummary?.NetMonthlyCashFlow ?? 0) >= 0 ? "text-success" : "text-danger")">
                                @((_financialSummary?.NetMonthlyCashFlow ?? 0) >= 0 ? "+ " : "- ")₹ @(Math.Abs(_financialSummary?.NetMonthlyCashFlow ?? 0m).ToString("N2"))
