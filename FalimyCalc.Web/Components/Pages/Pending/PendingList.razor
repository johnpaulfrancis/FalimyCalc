                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ApplyPreset(2)">📦 Amazon ₹1,850</button>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ApplyPreset(3)">⛽ Petrol ₹2,200</button>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ApplyPreset(4)">💡 Electricity ₹1,450</button>
