                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Bank Name</label>
                            <input class="form-control" @bind="SimBank" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Account / Card</label>
                            <input class="form-control" @bind="SimAccount" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button class="btn btn-outline-secondary" @onclick="() => ShowSimulate = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="CreateSimulatedTransaction" disabled="@IsProcessing">
                        @if (IsProcessing) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Add to Pending
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PendingTransaction> AllItems = [];
    private List<Category> Categories = [];
    private List<BankAccount> AllBankAccounts = [];
    private List<ExpenseService.BankAccountWithBalance> AccountsWithBalances = [];
    private List<FamilyMember> FamilyMembers = [];
    private PendingTransactionStatus? ActiveFilter = PendingTransactionStatus.Pending;
    private bool IsLoading = true;
    private bool IsProcessing = false;
    private string? SuccessMessage;

    private int PendingCount => AllItems.Count(x => x.Status == PendingTransactionStatus.Pending);
    private int ApprovedCount => AllItems.Count(x => x.Status == PendingTransactionStatus.Approved);
    private int RejectedCount => AllItems.Count(x => x.Status == PendingTransactionStatus.Rejected);

    private IEnumerable<PendingTransaction> FilteredItems => ActiveFilter.HasValue
        ? AllItems.Where(x => x.Status == ActiveFilter.Value)
        : AllItems;

    // ── Edit / Approve Modal State ─────────────────────────────────────────
    private PendingTransaction? ApprovingItem;
    private string ModalTransactionType = "expense"; // "expense" | "income" | "transfer"
    private decimal ModalAmount = 0;
    private string ModalDescription = string.Empty;
    private DateTime ModalDate = DateTime.Today;
    private string ModalCategoryValue = string.Empty;
    private string? ModalSuggestedNewCategory;
    private string? ModalMemberId;
    private Guid? ModalAccountGlobalId;
    private string? ModalAccountName;
    private Guid? ModalTransferDestAccountId;
    private string? ModalSubcategory;
    private string? ModalTags;
    private string? ModalNote;
    private bool ModalShowExtraDetails = false;
    private string? ModalError;

    private string? ModalAccountString
    {
        get => ModalAccountGlobalId?.ToString() ?? "";
        set
        {
            if (Guid.TryParse(value, out var g))
            {
                ModalAccountGlobalId = g;
                var acc = AllBankAccounts.FirstOrDefault(a => a.GlobalId == g);
                ModalAccountName = acc?.AccountName;
            }
            else
            {
                ModalAccountGlobalId = null;
            }
        }
    }

    private string? ModalTransferDestAccountString
    {
        get => ModalTransferDestAccountId?.ToString() ?? "";
        set
        {
            if (Guid.TryParse(value, out var g))
                ModalTransferDestAccountId = g;
            else
                ModalTransferDestAccountId = null;
        }
    }

    private List<BankAccount> AvailableBankAccountsList
    {
        get
        {
            if (Guid.TryParse(ModalMemberId, out var mId))
            {
                var filtered = AllBankAccounts.Where(a => a.MemberGlobalId == mId || a.HasMemberAccess(mId)).ToList();
                if (filtered.Any()) return filtered;
            }
            return AllBankAccounts;
        }
    }

    private decimal GetAccountBalance(Guid accountGlobalId)
    {
        var found = AccountsWithBalances.FirstOrDefault(a => a.Account.GlobalId == accountGlobalId);
        return found?.CurrentBalance ?? 0m;
    }

    private static readonly List<string> ExpenseSuggestions =
    [
        "🛒 Groceries", "⛽ Petrol / Fuel", "⚡ Electricity Bill", "🍕 Dining Out", "💊 Medicines", "📶 Mobile Recharge"
    ];

    private static readonly List<string> IncomeSuggestions =
    [
        "💼 Monthly Salary", "💻 Freelance Payment", "📈 Dividend / Return", "🎁 Cash Gift", "🏦 Bank Interest", "🏷️ Cashback / Refund"
    ];

    private static readonly List<string> TransferSuggestions =
    [
        "🏧 ATM Cash Withdrawal", "💳 Credit Card Bill Pay", "💰 Savings Allocation", "📱 Wallet Top-up", "🏦 Inter-bank Transfer"
    ];

    // Simulate Modal state
    private bool ShowSimulate = false;
    private string SimRawSms = string.Empty;
    private string SimMerchant = string.Empty;
    private decimal SimAmount = 0;
    private string SimBank = "HDFC Bank";
    private string SimAccount = "XX4012";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        IsLoading = true;
        AllItems = await ExpenseService.GetPendingTransactionsAsync();
        Categories = await ExpenseService.GetCategoriesAsync();
        AllBankAccounts = await ExpenseService.GetBankAccountsAsync();
        AccountsWithBalances = await ExpenseService.GetBankAccountsWithBalancesAsync();
        FamilyMembers = await ExpenseService.GetFamilyMembersAsync();
        IsLoading = false;
    }

    private void SetFilter(PendingTransactionStatus? status)
    {
        ActiveFilter = status;
        SelectedPendingIds.Clear();
    }

    private HashSet<Guid> SelectedPendingIds = [];

    private IEnumerable<PendingTransaction> PendingItemsInView =>
        FilteredItems.Where(x => x.Status == PendingTransactionStatus.Pending);

    private bool IsAllSelected =>
        PendingItemsInView.Any() && PendingItemsInView.All(x => SelectedPendingIds.Contains(x.GlobalId));

    private void ToggleSelect(Guid id, object? checkedValue)
    {
        bool isChecked = checkedValue is bool b && b;
        if (isChecked)
            SelectedPendingIds.Add(id);
        else
            SelectedPendingIds.Remove(id);
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        bool isChecked = e.Value is bool b && b;
        if (isChecked)
        {
            foreach (var item in PendingItemsInView)
            {
                SelectedPendingIds.Add(item.GlobalId);
            }
        }
        else
        {
            SelectedPendingIds.Clear();
        }
    }

    private decimal GetSelectedTotal()
    {
        return AllItems.Where(x => SelectedPendingIds.Contains(x.GlobalId))
                       .Sum(x => x.DetectedAmount ?? 0m);
    }

    private void ClearSelection()
    {
        SelectedPendingIds.Clear();
    }

    private static string? ExtractCategoryName(string? raw)
    {
        if (string.IsNullOrEmpty(raw)) return null;
        var match = System.Text.RegularExpressions.Regex.Match(raw, @"Category:\s*([^|\r\n]+)");
        return match.Success ? match.Groups[1].Value.Trim() : null;
    }

    private async Task ApproveSelectedAsync()
    {
        if (SelectedPendingIds.Count == 0) return;

        IsProcessing = true;
        try
        {
            var count = await ExpenseService.ApprovePendingTransactionsBatchAsync(
                SelectedPendingIds.ToList(),
                Session.CurrentUser?.GlobalId);

            SuccessMessage = $"Successfully approved and added {count} transaction(s) to Expenses!";
            SelectedPendingIds.Clear();
            await LoadData();
        }
        catch (Exception ex)
        {
            SuccessMessage = $"Failed to approve selected: {ex.Message}";
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task RejectSelectedAsync()
    {
        if (SelectedPendingIds.Count == 0) return;

        IsProcessing = true;
        try
        {
            var count = await ExpenseService.RejectPendingTransactionsBatchAsync(SelectedPendingIds.ToList());
            SuccessMessage = $"Rejected {count} pending transaction(s).";
            SelectedPendingIds.Clear();
            await LoadData();
        }
        catch (Exception ex)
        {
            SuccessMessage = $"Failed to reject selected: {ex.Message}";
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private DateOnly ModalDateOnly
    {
        get => DateOnly.FromDateTime(ModalDate);
        set => ModalDate = new DateTime(value.Year, value.Month, value.Day, ModalDate.Hour, ModalDate.Minute, ModalDate.Second);
    }

    private TimeOnly ModalTimeOnly
    {
        get => TimeOnly.FromDateTime(ModalDate);
        set => ModalDate = new DateTime(ModalDate.Year, ModalDate.Month, ModalDate.Day, value.Hour, value.Minute, 0);
    }

    private void SetModalTransactionType(string type)
    {
        ModalTransactionType = type;
        if (ModalTransactionType == "transfer" && !ModalTransferDestAccountId.HasValue)
        {
            var other = AllBankAccounts.FirstOrDefault(a => a.GlobalId != ModalAccountGlobalId);
            if (other != null) ModalTransferDestAccountId = other.GlobalId;
        }
    }

    private void AddModalAmount(decimal delta)
    {
        ModalAmount += delta;
    }

    private void SetModalDate(DateTime date)
    {
        ModalDate = new DateTime(date.Year, date.Month, date.Day, ModalDate.Hour, ModalDate.Minute, ModalDate.Second);
    }

    private void SetModalTimeToNow()
    {
        var now = DateTime.Now;
        ModalDate = new DateTime(ModalDate.Year, ModalDate.Month, ModalDate.Day, now.Hour, now.Minute, 0);
    }

    private void StartApprove(PendingTransaction item)
    {
        ApprovingItem = item;
        ModalError = null;
        ModalShowExtraDetails = false;

        // 1. Determine initial type
        if (!string.IsNullOrEmpty(item.RawSmsBody) && (item.RawSmsBody.Contains("self-transfer", StringComparison.OrdinalIgnoreCase) || item.RawSmsBody.Contains("Type: Self-Transfer", StringComparison.OrdinalIgnoreCase)))
        {
            ModalTransactionType = "transfer";
        }
        else if (item.DetectedType == TransactionType.Credit || (!string.IsNullOrEmpty(item.RawSmsBody) && item.RawSmsBody.Contains("Tags: income", StringComparison.OrdinalIgnoreCase)))
        {
            ModalTransactionType = "income";
        }
        else
        {
            ModalTransactionType = "expense";
        }

        // 2. Amount & Description
        ModalAmount = Math.Abs(item.DetectedAmount ?? 0);
        ModalDescription = item.DetectedMerchant ?? (ModalTransactionType == "income" ? "Income" : "Expense");

        // 3. Date & Time
        ModalDate = item.DetectedDate ?? item.CreatedAt;

        // 4. Member / Profile
        ModalMemberId = Session.CurrentUser?.GlobalId.ToString();

        // 5. Category
        var catName = ExtractCategoryName(item.RawSmsBody);
        ModalSuggestedNewCategory = null;
        if ((!string.IsNullOrEmpty(item.RawSmsBody) && item.RawSmsBody.Contains("self-transfer", StringComparison.OrdinalIgnoreCase)) ||
            string.Equals(catName, "Transfer", StringComparison.OrdinalIgnoreCase))
        {
            var transferCat = Categories.FirstOrDefault(c => string.Equals(c.Name, "Transfer", StringComparison.OrdinalIgnoreCase));
            if (transferCat != null)
            {
                ModalCategoryValue = transferCat.GlobalId.ToString();
            }
        }
        else if (!string.IsNullOrEmpty(catName))
        {
            var match = Categories.FirstOrDefault(c => string.Equals(c.Name, catName, StringComparison.OrdinalIgnoreCase));
            if (match != null)
            {
                ModalCategoryValue = match.GlobalId.ToString();
            }
            else
            {
                ModalSuggestedNewCategory = catName;
                ModalCategoryValue = "NEW";
            }
        }
        else
        {
            var matchedId = AutoMatchCategory(ModalDescription);
            ModalCategoryValue = matchedId.HasValue ? matchedId.Value.ToString() : string.Empty;
        }

        // 6. Bank Account
        ModalAccountName = item.DetectedAccount ?? item.DetectedBank;
        ModalAccountGlobalId = null;
        if (!string.IsNullOrWhiteSpace(ModalAccountName))
        {
            var matchedAcc = AllBankAccounts.FirstOrDefault(a =>
                string.Equals(a.AccountName, ModalAccountName, StringComparison.OrdinalIgnoreCase) ||
                (a.AccountNumberSuffix != null && ModalAccountName.Contains(a.AccountNumberSuffix)));
            if (matchedAcc != null)
            {
                ModalAccountGlobalId = matchedAcc.GlobalId;
                ModalAccountName = matchedAcc.AccountName;
            }
        }
        if (!ModalAccountGlobalId.HasValue && AllBankAccounts.Any())
        {
            ModalAccountGlobalId = AllBankAccounts.First().GlobalId;
            ModalAccountName = AllBankAccounts.First().AccountName;
        }

        // Destination account for transfers
        ModalTransferDestAccountId = null;
        if (ModalTransactionType == "transfer")
        {
            var toMatch = System.Text.RegularExpressions.Regex.Match(item.RawSmsBody ?? "", @"ToAccount:\s*([^|\r\n]+)");
            if (toMatch.Success)
            {
                var toName = toMatch.Groups[1].Value.Trim();
                var toAcc = AllBankAccounts.FirstOrDefault(a => string.Equals(a.AccountName, toName, StringComparison.OrdinalIgnoreCase) || (a.AccountNumberSuffix != null && toName.Contains(a.AccountNumberSuffix)));
                if (toAcc != null) ModalTransferDestAccountId = toAcc.GlobalId;
            }
            if (!ModalTransferDestAccountId.HasValue)
            {
                var otherAcc = AllBankAccounts.FirstOrDefault(a => a.GlobalId != ModalAccountGlobalId);
                if (otherAcc != null) ModalTransferDestAccountId = otherAcc.GlobalId;
            }
        }

        // 7. Extract Note, Tags, Subcategory
        ModalNote = null;
        if (!string.IsNullOrEmpty(item.RawSmsBody) && item.RawSmsBody.Contains("Note:"))
        {
            var m = System.Text.RegularExpressions.Regex.Match(item.RawSmsBody, @"Note:\s*([^|\r\n]+)");
            if (m.Success) ModalNote = m.Groups[1].Value.Trim();
        }

        ModalTags = null;
        if (!string.IsNullOrEmpty(item.RawSmsBody) && item.RawSmsBody.Contains("Tags:"))
        {
            var m = System.Text.RegularExpressions.Regex.Match(item.RawSmsBody, @"Tags:\s*([^|\r\n]+)");
            if (m.Success) ModalTags = m.Groups[1].Value.Trim();
        }

        ModalSubcategory = null;
        if (!string.IsNullOrEmpty(item.RawSmsBody) && item.RawSmsBody.Contains("Subcategory:"))
        {
            var m = System.Text.RegularExpressions.Regex.Match(item.RawSmsBody, @"Subcategory:\s*([^|\r\n]+)");
            if (m.Success) ModalSubcategory = m.Groups[1].Value.Trim();
        }

        if (!string.IsNullOrEmpty(ModalNote) || !string.IsNullOrEmpty(ModalTags) || !string.IsNullOrEmpty(ModalSubcategory))
        {
            ModalShowExtraDetails = true;
        }
    }

    private void StartEditApprove(PendingTransaction item)
    {
        StartApprove(item);
    }

    private Guid? AutoMatchCategory(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return null;
        var lower = text.ToLowerInvariant();

        foreach (var cat in Categories)
        {
            var catLower = cat.Name.ToLowerInvariant();
            if (lower.Contains(catLower) || catLower.Contains(lower))
                return cat.GlobalId;
        }

        // Common defaults
        if (lower.Contains("swiggy") || lower.Contains("zomato") || lower.Contains("restaurant") || lower.Contains("cafe") || lower.Contains("food"))
            return Categories.FirstOrDefault(c => c.Name.Contains("Food", StringComparison.OrdinalIgnoreCase))?.GlobalId;
        if (lower.Contains("amazon") || lower.Contains("flipkart") || lower.Contains("myntra") || lower.Contains("shopping"))
            return Categories.FirstOrDefault(c => c.Name.Contains("Shopping", StringComparison.OrdinalIgnoreCase))?.GlobalId;
        if (lower.Contains("uber") || lower.Contains("ola") || lower.Contains("petrol") || lower.Contains("fuel"))
            return Categories.FirstOrDefault(c => c.Name.Contains("Transport", StringComparison.OrdinalIgnoreCase))?.GlobalId;
        if (lower.Contains("bescom") || lower.Contains("electricity") || lower.Contains("bill") || lower.Contains("wifi") || lower.Contains("broadband"))
            return Categories.FirstOrDefault(c => c.Name.Contains("Utilities", StringComparison.OrdinalIgnoreCase))?.GlobalId;

        return Categories.FirstOrDefault()?.GlobalId;
    }

    private void CancelApprove()
    {
        ApprovingItem = null;
        ModalSuggestedNewCategory = null;
        ModalCategoryValue = string.Empty;
        ModalError = null;
    }

    private async Task SaveApproval()
    {
        if (ApprovingItem is null) return;

        if (string.IsNullOrWhiteSpace(ModalDescription))
        {
            ModalError = "Description is required.";
            return;
        }

        if (ModalAmount <= 0)
        {
            ModalError = "Amount must be greater than zero.";
            return;
        }

        if (ModalTransactionType == "transfer")
        {
            if (!ModalAccountGlobalId.HasValue || !ModalTransferDestAccountId.HasValue)
            {
                ModalError = "Please select both Source and Destination bank accounts for the transfer.";
                return;
            }
            if (ModalAccountGlobalId.Value == ModalTransferDestAccountId.Value)
            {
                ModalError = "Source and Destination accounts must be different.";
                return;
            }
        }

        Guid? selectedCategoryGuid = null;
        string? newCatNameToCreate = null;

        if (ModalTransactionType != "transfer")
        {
            if (ModalCategoryValue == "NEW" && !string.IsNullOrWhiteSpace(ModalSuggestedNewCategory))
            {
                newCatNameToCreate = ModalSuggestedNewCategory.Trim();
            }
            else if (Guid.TryParse(ModalCategoryValue, out var parsedGuid))
            {
                selectedCategoryGuid = parsedGuid;
            }
            else if (ModalTransactionType == "expense")
            {
                ModalError = "Please select or create a category.";
                return;
            }
        }

        IsProcessing = true;
        try
        {
            Guid? memberGuid = Guid.TryParse(ModalMemberId, out var mId) ? mId : Session.CurrentUser?.GlobalId;

            await ExpenseService.ApprovePendingTransactionAdvancedAsync(new ExpenseService.ApprovePendingRequest(
                PendingId: ApprovingItem.GlobalId,
                TransactionType: ModalTransactionType,
                Amount: ModalAmount,
                Description: ModalDescription.Trim(),
                TransactionDate: ModalDate,
                CategoryGlobalId: selectedCategoryGuid,
                NewCategoryName: newCatNameToCreate,
                AccountGlobalId: ModalAccountGlobalId,
                AccountName: ModalAccountName,
                MemberGlobalId: memberGuid,
                Subcategory: ModalSubcategory,
                Tags: ModalTags,
                Note: ModalNote,
                DestinationAccountGlobalId: ModalTransferDestAccountId
            ));

            SuccessMessage = $"Approved \"{ModalDescription}\" successfully!";
            ApprovingItem = null;
            ModalSuggestedNewCategory = null;
            ModalCategoryValue = string.Empty;
            await LoadData();
        }
        catch (Exception ex)
        {
            ModalError = $"Failed to approve: {ex.Message}";
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task SavePendingChangesAsync()
    {
        if (ApprovingItem is null) return;

        if (string.IsNullOrWhiteSpace(ModalDescription))
        {
            ModalError = "Description is required.";
            return;
        }

        if (ModalAmount <= 0)
        {
            ModalError = "Amount must be greater than zero.";
            return;
        }

        IsProcessing = true;
        try
        {
            string? catName = null;
            if (ModalCategoryValue == "NEW") catName = ModalSuggestedNewCategory;
            else if (Guid.TryParse(ModalCategoryValue, out var g))
            {
                catName = Categories.FirstOrDefault(c => c.GlobalId == g)?.Name;
            }

            var success = await ExpenseService.UpdatePendingTransactionAsync(new ExpenseService.UpdatePendingRequest(
                PendingId: ApprovingItem.GlobalId,
                TransactionType: ModalTransactionType,
                Amount: ModalAmount,
                Description: ModalDescription.Trim(),
                TransactionDate: ModalDate,
                Account: ModalAccountName,
                Bank: ModalAccountName,
                CategoryName: catName,
                Subcategory: ModalSubcategory,
                Tags: ModalTags,
                Note: ModalNote
            ));

            if (success)
            {
                SuccessMessage = $"Updated pending transaction \"{ModalDescription}\"!";
                ApprovingItem = null;
                await LoadData();
            }
            else
            {
                ModalError = "Failed to update pending transaction.";
            }
        }
        catch (Exception ex)
        {
            ModalError = $"Failed to update: {ex.Message}";
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task ConfirmReject(PendingTransaction item)
    {
        IsProcessing = true;
        try
        {
            await ExpenseService.RejectPendingTransactionAsync(item.GlobalId);
            SuccessMessage = $"Rejected transaction \"{item.DetectedMerchant ?? "Transaction"}\".";
            await LoadData();
        }
        catch (Exception ex)
        {
            SuccessMessage = $"Failed to reject: {ex.Message}";
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private void ShowSimulateModal()
    {
        ApplyPreset(1);
        ShowSimulate = true;
    }

