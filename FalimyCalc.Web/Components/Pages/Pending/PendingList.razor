@page "/pending"
@rendermode InteractiveServer
@using FalimyCalc.Data.Entities
@using FalimyCalc.Data.Services
@using FalimyCalc.Web.Services
@using FalimyCalc.Shared.Enums
@inject ExpenseService ExpenseService
@inject UserSessionService Session
@inject NavigationManager Nav

<PageTitle>Pending Transactions</PageTitle>

<div class="dash-header mb-4">
    <div>
        <h1 class="dash-title">Pending Transactions</h1>
        <p class="dash-subtitle">Review, edit, and approve detected and imported transactions before they become confirmed expenses</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/expenses" class="btn btn-outline-secondary d-flex align-items-center gap-1 shadow-sm">
            <span>←</span> <span>Expenses</span>
        </a>
        <button class="btn-primary-glow border-0" @onclick="ShowSimulateModal">
            <span class="btn-icon">⚡</span> Simulate SMS
        </button>
    </div>
</div>

<!-- Tabs & Status Filter -->
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
    <div class="btn-group" role="group">
        <button type="button" class="btn @(ActiveFilter == null ? "btn-primary" : "btn-outline-secondary")"
                @onclick="() => SetFilter(null)">
            All (@AllItems.Count)
        </button>
        <button type="button" class="btn @(ActiveFilter == PendingTransactionStatus.Pending ? "btn-primary" : "btn-outline-secondary")"
                @onclick="() => SetFilter(PendingTransactionStatus.Pending)">
            Pending
            @if (PendingCount > 0)
            {
                <span class="badge bg-warning text-dark ms-1">@PendingCount</span>
            }
        </button>
        <button type="button" class="btn @(ActiveFilter == PendingTransactionStatus.Approved ? "btn-primary" : "btn-outline-secondary")"
                @onclick="() => SetFilter(PendingTransactionStatus.Approved)">
            Approved (@ApprovedCount)
        </button>
        <button type="button" class="btn @(ActiveFilter == PendingTransactionStatus.Rejected ? "btn-primary" : "btn-outline-secondary")"
                @onclick="() => SetFilter(PendingTransactionStatus.Rejected)">
            Rejected (@RejectedCount)
        </button>
    </div>

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success py-1 px-3 mb-0 small alert-dismissible fade show" role="alert">
            @SuccessMessage
            <button type="button" class="btn-close py-2" @onclick="() => SuccessMessage = null"></button>
        </div>
    }
</div>

@if (IsLoading)
{
    <div class="skeleton-wrapper">
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
    </div>
}
else if (!FilteredItems.Any())
{
    <div class="chart-card text-center py-5">
        <span class="fs-1 d-block mb-2">📥</span>
        <h5 class="fw-bold">No transactions found</h5>
        <p class="text-muted mb-3">
            @(ActiveFilter == PendingTransactionStatus.Pending
                ? "You have caught up on all pending transactions!"
                : "No transactions match the selected filter.")
        </p>
        <button class="btn btn-primary btn-sm" @onclick="ShowSimulateModal">
            ⚡ Simulate a Bank SMS Transaction
        </button>
    </div>
}
else
{
    <!-- Bulk Action Toolbar -->
    @if (PendingItemsInView.Any())
    {
        <div class="card p-3 border-0 shadow-sm d-flex flex-row align-items-center justify-content-between flex-wrap gap-2 mb-3"
             style="background: var(--dash-surface); border: 1px solid var(--dash-border) !important; border-radius: 12px;">
            <div class="d-flex align-items-center gap-2">
                <input type="checkbox"
                       class="form-check-input"
                       id="selectAllPending"
                       style="width: 1.25rem; height: 1.25rem; cursor: pointer;"
                       checked="@IsAllSelected"
                       @onchange="ToggleSelectAll" />
                <label for="selectAllPending" class="form-check-label small fw-bold mb-0" style="cursor: pointer;">
                    Select All Pending (@PendingItemsInView.Count())
                </label>
            </div>

            @if (SelectedPendingIds.Count > 0)
            {
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge bg-primary px-2 py-1 small">
                        @SelectedPendingIds.Count selected
                    </span>
                    <span class="small fw-bold text-muted me-2">
                        Total: ₹ @GetSelectedTotal().ToString("N2")
                    </span>
                    <button class="btn btn-sm btn-success fw-semibold px-3 d-flex align-items-center gap-1"
                            @onclick="ApproveSelectedAsync"
                            disabled="@IsProcessing">
                        @if (IsProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <span>✓ Approve Selected (@SelectedPendingIds.Count)</span>
                    </button>
                    <button class="btn btn-sm btn-outline-danger fw-semibold"
                            @onclick="RejectSelectedAsync"
                            disabled="@IsProcessing">
                        ✕ Reject Selected
                    </button>
                    <button class="btn btn-sm btn-outline-secondary"
                            @onclick="ClearSelection"
                            disabled="@IsProcessing">
                        Clear
                    </button>
                </div>
            }
            else
            {
                <span class="small text-muted">
                    Check the boxes beside transactions to verify and approve multiple in batch.
                </span>
            }
        </div>
    }

    <div class="d-flex flex-column gap-3">
        @foreach (var item in FilteredItems)
        {
            var isPending = item.Status == PendingTransactionStatus.Pending;
            var isApproved = item.Status == PendingTransactionStatus.Approved;
            var isRejected = item.Status == PendingTransactionStatus.Rejected;
            var isExcelImport = !string.IsNullOrEmpty(item.RawSmsBody) && item.RawSmsBody.StartsWith("[Excel Import]");
            var parsedCatName = ExtractCategoryName(item.RawSmsBody);
            var isSelfTransfer = !string.IsNullOrEmpty(item.RawSmsBody) && (item.RawSmsBody.Contains("Type: Self-Transfer") || item.RawSmsBody.Contains("self-transfer"));
            var isTransferOutflow = isSelfTransfer && item.RawSmsBody.Contains("Outflow");
            var isCredit = item.DetectedType == FalimyCalc.Shared.Enums.TransactionType.Credit;

            <div class="card shadow-sm border-0 position-relative" style="overflow: hidden; border-radius: 14px;">
                <!-- Status accent line -->
                <div style="height: 4px; background: @(isPending ? "var(--c-amber)" : isApproved ? "var(--c-emerald)" : "var(--c-rose)");"></div>

                <div class="card-body p-3">
                    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2">
                        <!-- Left Details -->
                        <div class="d-flex align-items-start gap-3">
                            @if (isPending)
                            {
                                <div class="form-check pt-2">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="chk-@item.GlobalId"
                                           style="width: 1.35rem; height: 1.35rem; cursor: pointer;"
                                           checked="@SelectedPendingIds.Contains(item.GlobalId)"
                                           @onchange="(e) => ToggleSelect(item.GlobalId, e.Value)" />
                                </div>
                            }
                            <div class="rounded-circle d-grid place-items-center text-center p-2"
                                 style="width: 44px; height: 44px; background: @(isPending ? (isSelfTransfer ? "rgba(59, 130, 246, 0.15)" : "rgba(245, 158, 11, 0.15)") : isApproved ? "rgba(16, 185, 129, 0.15)" : "rgba(244, 63, 94, 0.15)");">
                                <span class="fs-5">@(isPending ? (isSelfTransfer ? "🔄" : isExcelImport ? "📊" : "⏳") : isApproved ? "✅" : "❌")</span>
                            </div>

                            <div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <h6 class="mb-0 fw-bold">@(item.DetectedMerchant ?? "Unknown Merchant")</h6>
                                    @if (isSelfTransfer)
                                    {
                                        @if (isTransferOutflow)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis small">
                                                🔄 Self-Transfer (Outflow)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis small">
                                                🔄 Self-Transfer (Inflow)
                                            </span>
                                        }
                                    }
                                    else if (isExcelImport)
                                    {
                                        <span class="badge bg-primary-subtle text-primary small">
                                            📊 Excel Import
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(parsedCatName))
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary small">
                                            📁 @parsedCatName
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.DetectedBank))
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary small">
                                            @item.DetectedBank @(!string.IsNullOrEmpty(item.DetectedAccount) ? $"({item.DetectedAccount})" : "")
                                        </span>
                                    }
                                    <span class="badge @(isPending ? "bg-warning text-dark" : isApproved ? "bg-success text-white" : "bg-danger text-white") small">
                                        @item.Status
                                    </span>
                                </div>

                                <div class="small text-muted mt-1">
                                    <span>📅 @(item.DetectedDate?.ToString("dd MMM yyyy, hh:mm tt") ?? item.CreatedAt.ToString("dd MMM yyyy, hh:mm tt"))</span>
                                    @if (item.DetectedType.HasValue)
                                    {
                                        <span class="ms-2">(@item.DetectedType.Value)</span>
                                    }
                                </div>

                                <!-- Collapsible / Expandable Details Preview -->
                                @if (!string.IsNullOrEmpty(item.RawSmsBody))
                                {
                                    <div class="mt-2 p-2 rounded small" style="background: var(--dash-surface-raised); border: 1px dashed var(--dash-border); max-width: 600px;">
                                        <span class="text-muted d-block" style="font-size: 0.75rem;">
                                            @(isExcelImport ? "Import Details:" : "SMS Content:")
                                        </span>
                                        <span class="font-monospace" style="font-size: 0.8rem;">@item.RawSmsBody</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Right Amount & Action Buttons -->
                        <div class="d-flex flex-column align-items-end justify-content-between gap-2 ms-auto">
                            <div class="fs-4 fw-bold" style="color: @(isCredit ? "var(--c-emerald)" : "var(--c-rose)");">
                                @(isCredit ? "+ " : "- ")₹ @(item.DetectedAmount?.ToString("N2") ?? "0.00")
                            </div>

                            @if (isPending)
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <button class="btn btn-sm btn-success px-3" @onclick="() => StartApprove(item)">
                                        ✓ Approve
                                    </button>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEditApprove(item)" title="Edit before approving">
                                        ✏️ Edit
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmReject(item)" title="Reject transaction">
                                        ✕
                                    </button>
                                </div>
                            }
                            else if (isApproved)
                            {
                                <span class="small text-success fw-semibold">
                                    ✓ Added to Expenses
                                </span>
                            }
                            else if (isRejected)
                            {
                                <span class="small text-muted">
                                    Rejected / Discarded
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- ── Edit / Approve Transaction Modal ────────────────────────────── -->
@if (ApprovingItem is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.65); backdrop-filter: blur(5px); z-index: 1055;">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0" style="background: var(--dash-surface); color: var(--dash-text); border-radius: 18px;">
                <!-- Modal Header -->
                <div class="modal-header border-bottom py-3 px-4 d-flex align-items-center justify-content-between" style="border-color: var(--dash-border) !important;">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fs-4">
                            @(ModalTransactionType == "income" ? "📈" : ModalTransactionType == "transfer" ? "🔁" : "💸")
                        </span>
                        <div>
                            <h5 class="modal-title fw-bold mb-0">
                                @(ModalTransactionType == "income" ? "Approve / Edit Income" : ModalTransactionType == "transfer" ? "Approve / Edit Transfer" : "Approve / Edit Expense")
                            </h5>
                            <span class="small text-muted">Review, adjust details, or change transaction type</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CancelApprove"></button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(ModalError))
                    {
                        <div class="alert alert-danger py-2 px-3 small mb-3">
                            @ModalError
                        </div>
                    }

                    <!-- 1. Transaction Type Switcher Tabs -->
                    <div class="row g-2 mb-4">
                        <div class="col-4">
                            <button type="button" class="btn w-100 p-2 text-start type-tab @(ModalTransactionType == "expense" ? "active-expense" : "")"
                                    @onclick='() => SetModalTransactionType("expense")'>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fs-4">💸</span>
                                    <div>
                                        <div class="fw-bold small">Expense</div>
                                        <div class="text-muted type-tab-sub">Money going out</div>
                                    </div>
                                </div>
                            </button>
                        </div>
                        <div class="col-4">
                            <button type="button" class="btn w-100 p-2 text-start type-tab @(ModalTransactionType == "income" ? "active-income" : "")"
                                    @onclick='() => SetModalTransactionType("income")'>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fs-4">📈</span>
                                    <div>
                                        <div class="fw-bold small">Income</div>
                                        <div class="text-muted type-tab-sub">Money coming in</div>
                                    </div>
                                </div>
                            </button>
                        </div>
                        <div class="col-4">
                            <button type="button" class="btn w-100 p-2 text-start type-tab @(ModalTransactionType == "transfer" ? "active-transfer" : "")"
                                    @onclick='() => SetModalTransactionType("transfer")'>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fs-4">🔁</span>
                                    <div>
                                        <div class="fw-bold small">Transfer</div>
                                        <div class="text-muted type-tab-sub">Between accounts</div>
                                    </div>
                                </div>
                            </button>
                        </div>
                    </div>

                    <!-- 2. Profile Selector (Admin only) -->
                    @if (Session.CurrentUser?.Role == "Admin")
                    {
                        <div class="mb-4">
                            <label class="form-label fw-semibold small text-muted text-uppercase mb-2">
                                Profile / Added For
                            </label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var member in FamilyMembers)
                                {
                                    var isSelected = ModalMemberId == member.GlobalId.ToString();
                                    <button type="button"
                                            class="btn member-select-chip @(isSelected ? "selected" : "")"
                                            style="border-color: @(isSelected ? member.Colour ?? "var(--c-indigo)" : "var(--dash-border)");"
                                            @onclick="() => ModalMemberId = member.GlobalId.ToString()">
                                        <span class="fs-5">@member.Avatar</span>
                                        <span class="fw-semibold small">@member.Name</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <!-- 3. Amount Input (Hero Field) -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold small text-muted text-uppercase mb-1">
                            Amount @(ModalTransactionType == "income" ? "Received" : ModalTransactionType == "transfer" ? "to Transfer" : "Spent") <span class="text-danger">*</span>
                        </label>
                        <div class="amount-input-wrap mb-2">
                            <span class="amount-currency">₹</span>
                            <input type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control amount-input @(ModalTransactionType == "income" ? "amount-input--income" : ModalTransactionType == "transfer" ? "amount-input--transfer" : "")"
                                   placeholder="0.00"
                                   @bind="ModalAmount"
                                   @bind:event="oninput" />
                        </div>
                        <!-- Quick Amount Increments -->
                        <div class="d-flex flex-wrap gap-1 align-items-center">
                            <span class="small text-muted me-1">Quick Add:</span>
                            @if (ModalTransactionType == "income")
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-chip" @onclick="() => AddModalAmount(500)">+₹500</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-chip" @onclick="() => AddModalAmount(1000)">+₹1,000</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-chip" @onclick="() => AddModalAmount(5000)">+₹5,000</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-chip" @onclick="() => AddModalAmount(10000)">+₹10,000</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-chip" @onclick="() => AddModalAmount(25000)">+₹25,000</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-chip" @onclick="() => AddModalAmount(100)">+₹100</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-chip" @onclick="() => AddModalAmount(500)">+₹500</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-chip" @onclick="() => AddModalAmount(1000)">+₹1,000</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-chip" @onclick="() => AddModalAmount(2000)">+₹2,000</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-chip" @onclick="() => AddModalAmount(5000)">+₹5,000</button>
                            }
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 text-danger quick-chip" @onclick="() => ModalAmount = 0">Clear</button>
                        </div>
                    </div>

                    <!-- 4. Description Field -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold small text-muted text-uppercase mb-1">
                            @(ModalTransactionType == "income" ? "Income Source / Description" : ModalTransactionType == "transfer" ? "Purpose / Transfer Description" : "Description / What was this for?") <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               class="form-control form-control-lg fs-6"
                               @bind="ModalDescription"
                               placeholder="e.g. Transaction Description"
                               maxlength="500" />
                        <!-- Quick Description Suggestions -->
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            <span class="small text-muted me-1 align-self-center">Suggestions:</span>
                            @foreach (var suggestion in (ModalTransactionType == "income" ? IncomeSuggestions : ModalTransactionType == "transfer" ? TransferSuggestions : ExpenseSuggestions))
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary py-0 px-2 suggestion-chip"
                                        @onclick="() => ModalDescription = suggestion">
                                    @suggestion
                                </button>
                            }
                        </div>
                    </div>

                    @if (ModalTransactionType == "transfer")
                    {
                        <!-- Transfer Specific Accounts (Source & Destination) -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small text-muted text-uppercase mb-1">
                                    Source Account (Deducted From) <span class="text-danger">*</span>
                                </label>
                                <select class="form-select" @bind="ModalAccountString">
                                    <option value="">— Select Source Account —</option>
                                    @foreach (var acc in AvailableBankAccountsList)
                                    {
                                        var bal = GetAccountBalance(acc.GlobalId);
                                        <option value="@acc.GlobalId">
                                            @acc.Icon @acc.AccountName (₹ @bal.ToString("N2"))
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small text-muted text-uppercase mb-1">
                                    Destination Account (Received By) <span class="text-danger">*</span>
                                </label>
                                <select class="form-select" @bind="ModalTransferDestAccountString">
                                    <option value="">— Select Destination Account —</option>
                                    @foreach (var acc in AvailableBankAccountsList.Where(a => a.GlobalId != ModalAccountGlobalId))
                                    {
                                        var bal = GetAccountBalance(acc.GlobalId);
                                        <option value="@acc.GlobalId">
                                            @acc.Icon @acc.AccountName (₹ @bal.ToString("N2"))
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- 5. Category Selector (Visual Chips) -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-semibold small text-muted text-uppercase mb-0">
                                    Category @(ModalTransactionType == "income" ? "(Optional)" : "") <span class="text-danger">*</span>
                                </label>
                                <a href="/categories" target="_blank" class="small text-decoration-none text-primary">
                                    + Manage Categories
                                </a>
                            </div>
                            <div class="category-chips-grid mb-2">
                                @if (!string.IsNullOrWhiteSpace(ModalSuggestedNewCategory))
                                {
                                    var isNewSelected = ModalCategoryValue == "NEW";
                                    <button type="button"
                                            class="category-select-pill @(isNewSelected ? "selected" : "")"
                                            style="border-color: @(isNewSelected ? "var(--c-amber)" : "var(--dash-border)"); background: @(isNewSelected ? "rgba(245, 158, 11, 0.15)" : "transparent");"
                                            @onclick='() => ModalCategoryValue = "NEW"'>
                                        <span class="cat-pill-icon">✨</span>
                                        <span class="cat-pill-text">Create "@ModalSuggestedNewCategory"</span>
                                    </button>
                                }
                                <button type="button"
                                        class="category-select-pill @(string.IsNullOrEmpty(ModalCategoryValue) ? "selected" : "")"
                                        @onclick='() => ModalCategoryValue = ""'>
                                    <span class="cat-pill-icon">📁</span>
                                    <span class="cat-pill-text">Uncategorised</span>
                                </button>
                                @foreach (var cat in Categories)
                                {
                                    var isSelected = ModalCategoryValue == cat.GlobalId.ToString();
                                    <button type="button"
                                            class="category-select-pill @(isSelected ? "selected" : "")"
                                            style="border-color: @(isSelected ? (cat.Colour ?? "var(--c-indigo)") : "var(--dash-border)"); background: @(isSelected ? (cat.Colour ?? "#6366f1") + "15" : "transparent");"
                                            @onclick="() => ModalCategoryValue = cat.GlobalId.ToString()">
                                        <span class="cat-pill-icon">@(string.IsNullOrWhiteSpace(cat.Icon) ? "📁" : cat.Icon)</span>
                                        <span class="cat-pill-text">@cat.Name</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <!-- 6. Date & Time & Account Row -->
                    <div class="row g-3 mb-4">
                        <!-- Date & Time -->
                        <div class="@(ModalTransactionType == "transfer" ? "col-12" : "col-md-5")">
                            <label class="form-label fw-semibold small text-muted text-uppercase mb-1">
                                Date & Time <span class="text-danger">*</span>
                            </label>
                            <div class="row g-2 mb-1">
                                <div class="col-7">
                                    <input type="date" class="form-control" @bind="ModalDateOnly" />
                                </div>
                                <div class="col-5">
                                    <input type="time" class="form-control" @bind="ModalTimeOnly" />
                                </div>
                            </div>
                            <!-- Quick Date Chips -->
                            <div class="d-flex gap-1 flex-wrap mb-1">
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary py-0 px-2 quick-chip @(ModalDate.Date == DateTime.Today ? "active" : "")"
                                        @onclick="() => SetModalDate(DateTime.Today)">
                                    Today
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary py-0 px-2 quick-chip @(ModalDate.Date == DateTime.Today.AddDays(-1) ? "active" : "")"
                                        @onclick="() => SetModalDate(DateTime.Today.AddDays(-1))">
                                    Yesterday
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary py-0 px-2 quick-chip"
                                        @onclick="SetModalTimeToNow">
                                    ⏱️ Now
                                </button>
                            </div>
                        </div>

                        <!-- Bank Account Selector (for Expense / Income) -->
                        @if (ModalTransactionType != "transfer")
                        {
                            <div class="col-md-7">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label fw-semibold small text-muted text-uppercase mb-0">
                                        @(ModalTransactionType == "income" ? "Deposited Into Account" : "Paid From Account")
                                    </label>
                                    <a href="/accounts" target="_blank" class="small text-decoration-none text-primary">
                                        + Manage Accounts
                                    </a>
                                </div>

                                @if (!AvailableBankAccountsList.Any())
                                {
                                    <input type="text" class="form-control form-control-sm" placeholder="Account Name (e.g. Cash, HDFC)" @bind="ModalAccountName" />
                                }
                                else
                                {
                                    <select class="form-select" @bind="ModalAccountString">
                                        <option value="">— Select Bank Account —</option>
                                        @foreach (var acc in AvailableBankAccountsList)
                                        {
                                            var bal = GetAccountBalance(acc.GlobalId);
                                            <option value="@acc.GlobalId">
                                                @acc.Icon @acc.AccountName (₹ @bal.ToString("N2"))
                                            </option>
                                        }
                                    </select>
                                    <span class="small text-muted d-block mt-1" style="font-size: 0.72rem;">
                                        @(ModalTransactionType == "income" ? "Account receiving this deposit" : "Account paying for this expense")
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <!-- 7. Additional Details (Notes, Tags, Subcategory) -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-semibold small text-muted text-uppercase">
                                Additional Details <span class="fw-normal text-muted">(Optional)</span>
                            </span>
                            <button type="button"
                                    class="btn btn-link btn-sm p-0 text-decoration-none text-muted"
                                    @onclick="() => ModalShowExtraDetails = !ModalShowExtraDetails">
                                @(ModalShowExtraDetails ? "▲ Hide Details" : "▼ Add Notes, Tags & Subcategory")
                            </button>
                        </div>

                        @if (ModalShowExtraDetails)
                        {
                            <div class="p-3 rounded-3" style="background: var(--dash-surface-raised); border: 1px solid var(--dash-border);">
                                <div class="row g-3">
                                    @if (ModalTransactionType != "transfer")
                                    {
                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold">Subcategory</label>
                                            <input type="text"
                                                   class="form-control form-control-sm"
                                                   placeholder="@(ModalTransactionType == "income" ? "e.g. Salary, Dividend, Bonus" : "e.g. Vegetables, Dinner, Fuel")"
                                                   @bind="ModalSubcategory" />
                                        </div>
                                    }

                                    <div class="@(ModalTransactionType == "transfer" ? "col-12" : "col-md-6")">
                                        <label class="form-label small fw-semibold">Tags</label>
                                        <input type="text"
                                               class="form-control form-control-sm"
                                               placeholder="e.g. #personal, #urgent, #office"
                                               @bind="ModalTags" />
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label small fw-semibold">Notes / Remarks</label>
                                        <textarea class="form-control form-control-sm"
                                                  rows="2"
                                                  placeholder="Add any specific memo or details..."
                                                  @bind="ModalNote"></textarea>
                                    </div>

                                    @if (!string.IsNullOrEmpty(ApprovingItem.RawSmsBody))
                                    {
                                        <div class="col-12">
                                            <label class="form-label small fw-semibold text-muted" style="font-size: 0.72rem;">Original Import / SMS Body</label>
                                            <div class="p-2 rounded font-monospace small" style="background: rgba(0,0,0,0.04); border: 1px dashed var(--dash-border); font-size: 0.75rem;">
                                                @ApprovingItem.RawSmsBody
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer border-top py-3 px-4 d-flex justify-content-between align-items-center" style="border-color: var(--dash-border) !important;">
                    <button class="btn btn-outline-secondary" @onclick="CancelApprove" disabled="@IsProcessing">Cancel</button>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-primary" @onclick="SavePendingChangesAsync" disabled="@IsProcessing" title="Save changes and keep in pending list">
                            @if (IsProcessing) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            💾 Save to Pending
                        </button>
                        <button class="btn @(ModalTransactionType == "income" ? "btn-success" : "btn-primary") fw-semibold px-4"
                                @onclick="SaveApproval" disabled="@IsProcessing">
                            @if (IsProcessing) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            ✓ Approve & Save
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Simulate SMS Modal -->
@if (ShowSimulate)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.55); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0" style="background: var(--dash-surface); color: var(--dash-text); border-radius: 16px;">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">⚡ Simulate Bank SMS</h5>
                    <button type="button" class="btn-close" @onclick="() => ShowSimulate = false"></button>
