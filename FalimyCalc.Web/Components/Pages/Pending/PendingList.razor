    private async Task CreateSimulatedTransaction()
    {
        if (SimAmount <= 0) return;

        IsProcessing = true;
        try
        {
            await ExpenseService.SimulateSmsTransactionAsync(
                SimRawSms,
                SimAmount,
                SimMerchant,
                SimBank,
                SimAccount,
                DateTime.Now
            );

            ShowSimulate = false;
            SuccessMessage = "Simulated transaction created and added to Pending!";
            ActiveFilter = PendingTransactionStatus.Pending;
            await LoadData();
        }
        finally
        {
            IsProcessing = false;
        }
    }
