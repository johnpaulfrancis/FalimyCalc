@code {
    private List<RecurringTransaction> Items = [];
    private List<Category> Categories = [];
    private List<BankAccount> BankAccounts = [];
    private List<FamilyMember> FamilyMembers = [];
    private Dictionary<Guid, FamilyMember> MemberMap = [];
    private ExpenseService.RecurringSummary Summary = new(0, 0, 0, 0, 0, 0, 0, 0, 0, []);

    private bool IsLoading = true;
    private bool IsSaving = false;
    private bool SuccessAlert = false;
    private string SuccessMessage = "";
    private string ActiveTab = "All";
    private string? SelectedMemberId;
    private bool _showAllMembers = false;

    // Create / Edit Modal
    private bool ShowModal = false;
    private string? ModalError;
    private RecurringTransaction EditingItem = new();
    private string? EditingCategoryString;
    private string? EditingAccountString;
    private string? EditingMemberString;

    // Mark as paid modal
    private RecurringTransaction? ItemToMarkPaid;
    private decimal PaidAmount;
    private DateTime PaidDate = DateTime.Today;
    private string? PaidAccountString;

    // Delete modal
    private RecurringTransaction? ItemToDelete;

    private readonly List<string> QuickIcons = ["🍿", "📦", "📶", "🏠", "🛡️", "🎵", "📱", "🏋️", "📈", "🚗", "💡", "🏫"];
    private readonly List<string> QuickColours = ["#e50914", "#00a8e1", "#1db954", "#6366f1", "#10b981", "#f59e0b", "#ec4899", "#8b5cf6"];

    private Guid? ActiveMemberFilter
    {
        get
        {
            if (Session.CurrentUser?.Role != "Admin")
                return Session.CurrentUser?.GlobalId;

            if (Guid.TryParse(SelectedMemberId, out var g))
                return g;

            return _showAllMembers ? null : Session.CurrentUser?.GlobalId;
        }
    }

    private IEnumerable<RecurringTransaction> FilteredItems
    {
        get
        {
            var today = DateTime.Today;
            var in7Days = today.AddDays(7);
            var query = Items.AsEnumerable();

            if (ActiveTab == "Active") query = query.Where(r => r.Status == "Active");
            else if (ActiveTab == "Paused") query = query.Where(r => r.Status == "Paused");
            else if (ActiveTab == "DueSoon") query = query.Where(r => r.Status == "Active" && r.NextDueDate.Date >= today && r.NextDueDate.Date <= in7Days);

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Categories = await ExpenseService.GetCategoriesAsync();
        FamilyMembers = await ExpenseService.GetFamilyMembersAsync();
        MemberMap = FamilyMembers.ToDictionary(m => m.GlobalId);
        _showAllMembers = false;
        BankAccounts = await ExpenseService.GetBankAccountsAsync(ActiveMemberFilter);

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        Items = await ExpenseService.GetRecurringTransactionsAsync(ActiveMemberFilter);
        Summary = await ExpenseService.GetRecurringSummaryAsync(ActiveMemberFilter);
        IsLoading = false;
    }

    private async Task SetViewMode(bool showAll)
    {
        _showAllMembers = showAll;
        SelectedMemberId = null;
        BankAccounts = await ExpenseService.GetBankAccountsAsync(ActiveMemberFilter);
        await LoadDataAsync();
    }

    private async Task OnMemberFilterChanged()
    {
        if (string.IsNullOrEmpty(SelectedMemberId)) _showAllMembers = true;
        else if (Guid.TryParse(SelectedMemberId, out var sg) && sg == Session.CurrentUser?.GlobalId) _showAllMembers = false;

        BankAccounts = await ExpenseService.GetBankAccountsAsync(ActiveMemberFilter);
        await LoadDataAsync();
    }

    private void SetTab(string tab)
    {
        ActiveTab = tab;
    }

    private void OpenCreateModal()
    {
        EditingItem = new RecurringTransaction
        {
            Frequency = "Monthly",
            Type = "Expense",
            NextDueDate = DateTime.Today,
            Colour = "#6366f1",
            Icon = "🔁",
            Status = "Active"
        };
        EditingCategoryString = null;
        EditingAccountString = null;
        EditingMemberString = Session.CurrentUser?.Role == "Admin" ? SelectedMemberId : Session.CurrentUser?.GlobalId.ToString();
        ModalError = null;
        ShowModal = true;
    }

    private void QuickAddPreset(string name, decimal amount, string freq, string icon, string color)
    {
        EditingItem = new RecurringTransaction
        {
            Name = name,
            Amount = amount,
            Frequency = freq,
            Type = "Expense",
            NextDueDate = DateTime.Today,
            Icon = icon,
            Colour = color,
            Status = "Active"
        };
        EditingCategoryString = null;
        EditingAccountString = null;
        EditingMemberString = Session.CurrentUser?.Role == "Admin" ? SelectedMemberId : Session.CurrentUser?.GlobalId.ToString();
        ModalError = null;
        ShowModal = true;
    }

    private void OpenEditModal(RecurringTransaction item)
    {
        EditingItem = new RecurringTransaction
        {
            Id = item.Id,
            GlobalId = item.GlobalId,
            Name = item.Name,
            Amount = item.Amount,
            Type = item.Type,
            Frequency = item.Frequency,
            NextDueDate = item.NextDueDate,
            LastPaidDate = item.LastPaidDate,
            CategoryId = item.CategoryId,
            CategoryGlobalId = item.CategoryGlobalId,
            BankAccountId = item.BankAccountId,
            AccountGlobalId = item.AccountGlobalId,
            MemberGlobalId = item.MemberGlobalId,
            Colour = item.Colour,
            Icon = item.Icon,
            Status = item.Status,
            AutoLog = item.AutoLog,
            Note = item.Note
        };
        EditingCategoryString = item.CategoryGlobalId?.ToString();
        EditingAccountString = item.AccountGlobalId?.ToString();
        EditingMemberString = item.MemberGlobalId?.ToString();
        ModalError = null;
        ShowModal = true;
    }

    private void CloseModal()
    {
        ShowModal = false;
        ModalError = null;
    }

    private async Task SaveRecurringAsync()
    {
        ModalError = null;
        if (string.IsNullOrWhiteSpace(EditingItem.Name))
        {
            ModalError = "Please enter a name for this recurring transaction.";
            return;
        }

        if (EditingItem.Amount <= 0)
        {
            ModalError = "Amount must be greater than zero.";
            return;
        }

        IsSaving = true;
        try
        {
            if (Guid.TryParse(EditingCategoryString, out var cId)) EditingItem.CategoryGlobalId = cId;
            else EditingItem.CategoryGlobalId = null;

            if (Guid.TryParse(EditingAccountString, out var aId)) EditingItem.AccountGlobalId = aId;
            else EditingItem.AccountGlobalId = null;

            if (Guid.TryParse(EditingMemberString, out var mId)) EditingItem.MemberGlobalId = mId;
            else EditingItem.MemberGlobalId = null;

            if (EditingItem.Id == 0)
            {
                await ExpenseService.CreateRecurringTransactionAsync(EditingItem, EditingItem.MemberGlobalId);
            }
            else
            {
                await ExpenseService.UpdateRecurringTransactionAsync(EditingItem);
            }

            ShowModal = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ModalError = $"Failed to save: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task TogglePauseAsync(RecurringTransaction item)
    {
        item.Status = item.Status == "Active" ? "Paused" : "Active";
        await ExpenseService.UpdateRecurringTransactionAsync(item);
        await LoadDataAsync();
    }

    private void PromptMarkAsPaid(RecurringTransaction item)
    {
        ItemToMarkPaid = item;
        PaidAmount = item.Amount;
        PaidDate = DateTime.Today;
        PaidAccountString = item.AccountGlobalId?.ToString();
    }

    private async Task ExecuteMarkAsPaidAsync()
    {
        if (ItemToMarkPaid == null) return;
        IsSaving = true;
        try
        {
            Guid? accId = Guid.TryParse(PaidAccountString, out var aId) ? aId : null;
            await ExpenseService.MarkRecurringAsPaidAsync(ItemToMarkPaid.GlobalId, PaidAmount, PaidDate, accId);

            SuccessMessage = $"Recorded ₹{PaidAmount:N2} for {ItemToMarkPaid.Name} and rolled due date forward!";
            SuccessAlert = true;
            ItemToMarkPaid = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ModalError = $"Error logging payment: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void ConfirmDelete(RecurringTransaction item)
    {
        ItemToDelete = item;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (ItemToDelete != null)
        {
            await ExpenseService.DeleteRecurringTransactionAsync(ItemToDelete.GlobalId);
            ItemToDelete = null;
            await LoadDataAsync();
        }
    }
}
