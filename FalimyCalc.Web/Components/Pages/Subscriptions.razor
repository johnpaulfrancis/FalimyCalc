@page "/subscriptions"
@rendermode InteractiveServer
@using FalimyCalc.Data.Entities
@using FalimyCalc.Data.Services
@using FalimyCalc.Web.Services
@inject ExpenseService ExpenseService
@inject UserSessionService Session
@inject NavigationManager Nav

<PageTitle>Recurring Bills & Subscriptions — FalimyCalc</PageTitle>

<!-- ── Page Header ─────────────────────────────────────────────────────────── -->
<div class="dash-header mb-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h1 class="dash-title mb-0">Recurring Bills & Subscriptions</h1>
            <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary fs-7 fw-semibold px-2 py-1">
                @Items.Count recurring items
            </span>
        </div>
        <p class="dash-subtitle mt-1 mb-0">
            @(Session.CurrentUser?.Role == "Admin"
                ? "Track subscriptions, automated utilities, rent, SIPs, and periodic bills across all family profiles"
                : $"Track your periodic subscriptions, rent, SIPs, and automated bills ({Session.CurrentUser?.Name})")
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap align-items-center">
        @if (Summary.DueNext7DaysCount > 0 || Summary.OverdueCount > 0)
        {
            <button type="button" class="btn btn-warning btn-sm d-inline-flex align-items-center gap-1 rounded-pill px-3 fw-semibold shadow-sm"
                    @onclick='() => SetTab("DueSoon")'>
                <span>⏳</span> @(Summary.OverdueCount > 0 ? $"{Summary.OverdueCount} Overdue / " : "")@Summary.DueNext7DaysCount Due Soon
            </button>
        }
        <button type="button" class="btn-primary-glow" @onclick="OpenCreateModal">
            <span class="btn-icon">＋</span> Add Recurring Bill
        </button>
    </div>
</div>

<!-- ── Admin One-Tap Switcher (Me vs All Family) ───────────────────────────── -->
@if (Session.CurrentUser?.Role == "Admin")
{
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 p-2 rounded-3" style="background: var(--dash-surface); border: 1px solid var(--dash-border);">
        <div class="d-flex align-items-center gap-2">
            <span class="small fw-semibold text-muted">Quick View:</span>
            <div class="view-toggle">
                <button type="button" class="view-toggle-btn @(!_showAllMembers && string.IsNullOrEmpty(SelectedMemberId) ? "active" : "")"
                        @onclick="() => SetViewMode(false)">
                    @Session.CurrentUser.Avatar Me (@Session.CurrentUser.Name)
                </button>
                <button type="button" class="view-toggle-btn @(_showAllMembers && string.IsNullOrEmpty(SelectedMemberId) ? "active" : "")"
                        @onclick="() => SetViewMode(true)">
                    👨‍👩‍👧‍👦 All Family
                </button>
            </div>
            <select class="form-select form-select-sm" style="width: auto;" @bind="SelectedMemberId" @bind:after="OnMemberFilterChanged">
                <option value="">👥 All Profiles</option>
                @foreach (var member in FamilyMembers)
                {
                    <option value="@member.GlobalId">@member.Avatar @member.Name</option>
                }
            </select>
        </div>
    </div>
}

<!-- ── Quick Toast Alert ──────────────────────────────────────────────────── -->
@if (SuccessAlert)
{
    <div class="alert alert-success py-2 px-3 mb-3 small animate-in d-flex align-items-center justify-content-between">
        <span>✅ @SuccessMessage</span>
        <button type="button" class="btn-close btn-close-sm" @onclick="() => SuccessAlert = false"></button>
    </div>
}

<!-- ── Top KPI Stat Cards ──────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <!-- 1. Monthly Normalized Cost -->
    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 h-100 border-0 shadow-sm" style="background: var(--dash-surface); border: 1px solid var(--dash-border) !important; border-radius: 14px;">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="small fw-semibold text-muted text-uppercase" style="font-size: 0.72rem;">Monthly Recurring Cost</span>
                <span class="fs-5">💳</span>
            </div>
            <h3 class="mb-1 fw-bold" style="color: var(--c-rose, #f43f5e); font-variant-numeric: tabular-nums;">
                ₹ @Summary.MonthlyEquivalentExpense.ToString("N2")
            </h3>
            <div class="d-flex align-items-center justify-content-between mt-auto pt-2 border-top" style="border-color: var(--dash-border) !important;">
                <span class="text-muted small" style="font-size: 0.75rem;">Normalized monthly</span>
                <span class="badge bg-danger-subtle text-danger small">Fixed Outflow</span>
            </div>
        </div>
    </div>

    <!-- 2. Annual Run Rate -->
    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 h-100 border-0 shadow-sm" style="background: var(--dash-surface); border: 1px solid var(--dash-border) !important; border-radius: 14px;">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="small fw-semibold text-muted text-uppercase" style="font-size: 0.72rem;">Annual Projected Run-Rate</span>
                <span class="fs-5">📅</span>
            </div>
            <h3 class="mb-1 fw-bold" style="color: var(--dash-text); font-variant-numeric: tabular-nums;">
                ₹ @Summary.AnnualProjectedExpense.ToString("N2")
            </h3>
            <div class="d-flex align-items-center justify-content-between mt-auto pt-2 border-top" style="border-color: var(--dash-border) !important;">
                <span class="text-muted small" style="font-size: 0.75rem;">Yearly commitment</span>
                <span class="badge bg-secondary-subtle text-secondary small">12-Month Total</span>
            </div>
        </div>
    </div>

    <!-- 3. Due Soon / Overdue -->
    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 h-100 border-0 shadow-sm" style="background: var(--dash-surface); border: 1px solid var(--dash-border) !important; border-radius: 14px;">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="small fw-semibold text-muted text-uppercase" style="font-size: 0.72rem;">Due in Next 7 Days</span>
                <span class="fs-5">⏳</span>
            </div>
            <h3 class="mb-1 fw-bold @(Summary.OverdueCount > 0 ? "text-danger" : Summary.DueNext7DaysCount > 0 ? "text-warning" : "text-success")" style="font-variant-numeric: tabular-nums;">
                ₹ @((Summary.DueNext7DaysAmount + Summary.OverdueAmount).ToString("N2"))
            </h3>
            <div class="d-flex align-items-center justify-content-between mt-auto pt-2 border-top" style="border-color: var(--dash-border) !important;">
                <span class="text-muted small" style="font-size: 0.75rem;">
                    @(Summary.OverdueCount > 0 ? $"{Summary.OverdueCount} overdue! " : "")@Summary.DueNext7DaysCount upcoming
                </span>
                <span class="badge @(Summary.OverdueCount > 0 ? "bg-danger" : Summary.DueNext7DaysCount > 0 ? "bg-warning text-dark" : "bg-success-subtle text-success") small">
                    @(Summary.OverdueCount > 0 ? "Action Required" : Summary.DueNext7DaysCount > 0 ? "Due Soon" : "All Clear")
                </span>
            </div>
        </div>
    </div>

    <!-- 4. Active Subscriptions -->
    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 h-100 border-0 shadow-sm" style="background: var(--dash-surface); border: 1px solid var(--dash-border) !important; border-radius: 14px;">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="small fw-semibold text-muted text-uppercase" style="font-size: 0.72rem;">Active Subscriptions</span>
                <span class="fs-5">⚡</span>
            </div>
            <h3 class="mb-1 fw-bold" style="color: var(--dash-text);">
                @Summary.ActiveCount <span class="fs-6 fw-normal text-muted">of @Summary.TotalCount active</span>
            </h3>
            <div class="d-flex align-items-center justify-content-between mt-auto pt-2 border-top" style="border-color: var(--dash-border) !important;">
                <span class="text-muted small" style="font-size: 0.75rem;">@Summary.PausedCount paused</span>
                <span class="badge bg-primary-subtle text-primary small">Auto-Tracked</span>
            </div>
        </div>
    </div>
</div>

<!-- ── Filter Tabs ─────────────────────────────────────────────────────────── -->
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div class="btn-group btn-group-sm">
        <button type="button" class="btn @(ActiveTab == "All" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SetTab("All")'>
            All Bills (@Items.Count)
        </button>
        <button type="button" class="btn @(ActiveTab == "Active" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SetTab("Active")'>
            ⚡ Active (@Items.Count(r => r.Status == "Active"))
        </button>
        <button type="button" class="btn @(ActiveTab == "DueSoon" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SetTab("DueSoon")'>
            ⏳ Due Soon / Overdue (@(Summary.DueNext7DaysCount + Summary.OverdueCount))
        </button>
        <button type="button" class="btn @(ActiveTab == "Paused" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SetTab("Paused")'>
            ⏸️ Paused (@Items.Count(r => r.Status == "Paused"))
        </button>
    </div>
</div>

<!-- ── Subscriptions Grid ──────────────────────────────────────────────────── -->
@if (IsLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary mb-2" role="status"></div>
        <p class="text-muted small">Loading recurring bills & subscriptions...</p>
    </div>
}
else if (!FilteredItems.Any())
{
    <div class="card border-0 shadow-sm p-5 text-center mb-4" style="background: var(--dash-surface); border: 1px solid var(--dash-border) !important; border-radius: 16px;">
        <div class="fs-1 mb-2">🔁</div>
        <h4 class="fw-bold" style="color: var(--dash-text);">No Recurring Bills Recorded</h4>
        <p class="text-muted small mb-4" style="max-width: 480px; margin: 0 auto;">
            Never get surprised by auto-debit payments or forget when rent, broadband, school fees, or subscriptions are due.
        </p>

        <!-- Common Quick Presets -->
        <div class="d-flex justify-content-center gap-2 flex-wrap mb-4">
            <button class="btn btn-outline-secondary btn-sm" @onclick='() => QuickAddPreset("🍿 Netflix 4K", 649, "Monthly", "🍿", "#e50914")'>
                🍿 Netflix (₹649/mo)
            </button>
            <button class="btn btn-outline-secondary btn-sm" @onclick='() => QuickAddPreset("📦 Amazon Prime", 1499, "Yearly", "📦", "#00a8e1")'>
                📦 Amazon Prime (₹1,499/yr)
            </button>
            <button class="btn btn-outline-secondary btn-sm" @onclick='() => QuickAddPreset("📶 Fiber Broadband", 999, "Monthly", "📶", "#6366f1")'>
                📶 Broadband (₹999/mo)
            </button>
            <button class="btn btn-outline-secondary btn-sm" @onclick='() => QuickAddPreset("🏠 House Rent", 25000, "Monthly", "🏠", "#10b981")'>
                🏠 House Rent (₹25,000/mo)
            </button>
            <button class="btn btn-outline-secondary btn-sm" @onclick='() => QuickAddPreset("📈 Mutual Fund SIP", 5000, "Monthly", "📈", "#f59e0b")'>
                📈 SIP Investment (₹5,000/mo)
            </button>
        </div>

        <div>
            <button class="btn btn-primary" @onclick="OpenCreateModal">
                ➕ Add Your First Recurring Bill
            </button>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in FilteredItems)
        {
            var today = DateTime.Today;
            var daysUntil = (item.NextDueDate.Date - today).Days;
            var isOverdue = daysUntil < 0 && item.Status == "Active";
            var isDueToday = daysUntil == 0 && item.Status == "Active";
            var isDueSoon = daysUntil > 0 && daysUntil <= 7 && item.Status == "Active";
            var isPaused = item.Status == "Paused";
            var itemColor = string.IsNullOrWhiteSpace(item.Colour) ? "#6366f1" : item.Colour;
            var monthlyCost = ExpenseService.CalculateMonthlyEquivalent(item.Amount, item.Frequency);
            var owner = item.MemberGlobalId.HasValue && MemberMap.TryGetValue(item.MemberGlobalId.Value, out var m) ? m : null;

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 position-relative subscription-card"
                     style="background: var(--dash-surface); border: 1px solid var(--dash-border) !important; border-radius: 14px; overflow: hidden; opacity: @(isPaused ? "0.75" : "1");">
                    
                    <!-- Top color accent -->
                    <div style="height: 5px; background: @itemColor; width: 100%;"></div>

                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <!-- Header: Icon, Name, Frequency & Badges -->
                        <div class="d-flex align-items-start justify-content-between mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="sub-icon-box" style="background: @(itemColor)20; border: 1px solid @(itemColor)40; color: @itemColor;">
                                    <span class="fs-4">@(string.IsNullOrWhiteSpace(item.Icon) ? "🔁" : item.Icon)</span>
                                </div>
                                <div>
                                    <h5 class="mb-0 fw-bold" style="color: var(--dash-text); font-size: 1.05rem;">
                                        @item.Name
                                    </h5>
                                    <div class="d-flex align-items-center gap-1 mt-1 flex-wrap">
                                        <span class="badge bg-secondary-subtle text-secondary small" style="font-size: 0.7rem;">
                                            @item.Frequency
                                        </span>
                                        @if (item.Category != null)
                                        {
                                            <span class="badge border small d-inline-flex align-items-center gap-1"
                                                  style="font-size: 0.7rem; background: @(item.Category.Colour ?? "#6366f1")15; color: @(item.Category.Colour ?? "#6366f1");">
                                                <span>@item.Category.Icon</span>
                                                <span>@item.Category.Name</span>
                                            </span>
                                        }
                                        @if (owner != null)
                                        {
                                            <span class="member-chip" style="background-color: @(owner.Colour ?? "#4f46e5"); font-size: 0.65rem; padding: 1px 6px;">
                                                <span>@owner.Avatar</span>
                                                <span>@owner.Name</span>
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Due Date Pill -->
                            <div>
                                @if (isPaused)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary px-2 py-1" style="font-size: 0.72rem;">
                                        ⏸️ Paused
                                    </span>
                                }
                                else if (isOverdue)
                                {
                                    <span class="badge bg-danger text-white px-2 py-1 pulse-badge" style="font-size: 0.72rem;">
                                        🚨 Overdue @(Math.Abs(daysUntil))d
                                    </span>
                                }
                                else if (isDueToday)
                                {
                                    <span class="badge bg-danger text-white px-2 py-1 pulse-badge" style="font-size: 0.72rem;">
                                        ⚡ Due Today!
                                    </span>
                                }
                                else if (isDueSoon)
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1" style="font-size: 0.72rem;">
                                        ⏳ Due in @daysUntil d
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary px-2 py-1" style="font-size: 0.72rem;">
                                        📅 in @daysUntil d
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Amount Banner & Details -->
                        <div class="p-3 rounded-3 mb-3" style="background: var(--dash-surface-raised); border: 1px solid var(--dash-border);">
                            <div class="d-flex justify-content-between align-items-baseline mb-1">
                                <span class="small text-muted fw-semibold text-uppercase" style="font-size: 0.7rem;">Amount</span>
                                <span class="small text-muted" style="font-size: 0.72rem;">
                                    ≈ <strong>₹ @monthlyCost.ToString("N0")</strong> / month
                                </span>
                            </div>

                            <h3 class="fw-bold mb-2 @(item.Type == "Income" ? "text-success" : "")" style="@(item.Type == "Expense" ? "color: var(--c-rose, #f43f5e);" : "") font-variant-numeric: tabular-nums;">
                                @(item.Type == "Income" ? "+ " : "")₹ @item.Amount.ToString("N2")
                                <span class="fs-6 fw-normal text-muted">/ @item.Frequency.ToLowerInvariant()</span>
                            </h3>

                            <!-- Next Due & Account -->
                            <div class="d-flex justify-content-between align-items-center small text-muted pt-2 border-top" style="border-color: var(--dash-border) !important; font-size: 0.75rem;">
                                <span>
                                    Next: <strong class="@(isOverdue ? "text-danger" : isDueSoon ? "text-warning" : "text-dark")">@item.NextDueDate.ToString("dd MMM yyyy")</strong>
                                </span>
                                @if (item.LastPaidDate.HasValue)
                                {
                                    <span>Last: @item.LastPaidDate.Value.ToString("dd MMM")</span>
                                }
                            </div>
                        </div>

                        <!-- Bank Account & Notes -->
                        @if (item.BankAccount != null || !string.IsNullOrWhiteSpace(item.Note))
                        {
                            <div class="d-flex align-items-center justify-content-between small text-muted mb-3 px-1">
                                @if (item.BankAccount != null)
                                {
                                    <span class="badge border small d-inline-flex align-items-center gap-1"
                                          style="font-size: 0.7rem; background: @(item.BankAccount.Colour ?? "#4f46e5")15; color: @(item.BankAccount.Colour ?? "#4f46e5"); border-color: @(item.BankAccount.Colour ?? "#4f46e5")30 !important;">
                                        <span>@(item.BankAccount.Icon ?? "🏦")</span>
                                        <span>@item.BankAccount.AccountName</span>
                                    </span>
                                }
                                else
                                {
                                    <span></span>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.Note))
                                {
                                    <span class="text-truncate text-muted small" style="max-width: 160px;" title="@item.Note">
                                        📝 @item.Note
                                    </span>
                                }
                            </div>
                        }

                        <!-- Action Buttons -->
                        <div class="d-flex gap-1 pt-2 border-top" style="border-color: var(--dash-border) !important;">
                            @if (!isPaused)
                            {
                                <button type="button" class="btn btn-sm btn-success flex-fill py-1 px-1 fw-semibold d-flex align-items-center justify-content-center gap-1 shadow-sm"
                                        @onclick="() => PromptMarkAsPaid(item)" title="Record payment for this bill and roll to next due date">
                                    <span>✓</span> <span>Mark Paid</span>
                                </button>
                            }
                            <button type="button" class="btn btn-sm btn-outline-secondary px-2"
                                    @onclick="() => TogglePauseAsync(item)" title="@(isPaused ? "Resume Subscription" : "Pause Subscription")">
                                @(isPaused ? "▶️" : "⏸️")
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary px-2"
                                    @onclick="() => OpenEditModal(item)" title="Edit Bill Details">
                                ✏️
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger px-2"
                                    @onclick="() => ConfirmDelete(item)" title="Delete Subscription">
                                🗑️
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- ── Create / Edit Modal ────────────────────────────────────────────────── -->
@if (ShowModal)
{
    <div class="modal-backdrop-custom" @onclick="CloseModal"></div>
    <div class="modal-panel shadow-lg animate-in" style="max-width: 540px;">
        <div class="modal-panel-header">
            <h5 class="mb-0 fw-bold d-flex align-items-center gap-2">
                <span>@(EditingItem.Id == 0 ? "🔁 Add Recurring Bill / Subscription" : "✏️ Edit Subscription")</span>
            </h5>
            <button type="button" class="btn-close" @onclick="CloseModal"></button>
        </div>
        <div class="modal-panel-body">
            @if (!string.IsNullOrEmpty(ModalError))
            {
                <div class="alert alert-danger py-2 px-3 small mb-3">
                    @ModalError
                </div>
            }

            <!-- 1. Name -->
            <div class="mb-3">
                <label class="form-label small fw-semibold text-uppercase text-muted">Bill / Subscription Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control" placeholder="e.g. Netflix, Airtel Fiber, House Rent, Gym, SIP" @bind="EditingItem.Name" maxlength="150" />
            </div>

            <!-- 2. Amount & Type -->
            <div class="row g-2 mb-3">
                <div class="col-sm-6">
                    <label class="form-label small fw-semibold text-uppercase text-muted">Amount (₹) <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" min="1" class="form-control" placeholder="0.00" @bind="EditingItem.Amount" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label small fw-semibold text-uppercase text-muted">Transaction Type</label>
                    <select class="form-select" @bind="EditingItem.Type">
                        <option value="Expense">💸 Expense (Outflow)</option>
                        <option value="Income">📈 Income (Inflow)</option>
                    </select>
                </div>
            </div>

            <!-- 3. Frequency & Next Due Date -->
            <div class="row g-2 mb-3">
                <div class="col-sm-6">
                    <label class="form-label small fw-semibold text-uppercase text-muted">Billing Cycle <span class="text-danger">*</span></label>
                    <select class="form-select" @bind="EditingItem.Frequency">
                        <option value="Daily">Daily</option>
                        <option value="Weekly">Weekly (Every 7 days)</option>
                        <option value="Bi-Weekly">Bi-Weekly (Every 14 days)</option>
                        <option value="Monthly">Monthly</option>
                        <option value="Quarterly">Quarterly (Every 3 months)</option>
                        <option value="Semi-Annually">Semi-Annually (Every 6 months)</option>
                        <option value="Yearly">Yearly (Annual)</option>
                    </select>
                </div>
                <div class="col-sm-6">
                    <label class="form-label small fw-semibold text-uppercase text-muted">Next Due Date <span class="text-danger">*</span></label>
                    <input type="date" class="form-control" @bind="EditingItem.NextDueDate" />
                </div>
            </div>

            <!-- 4. Category & Bank Account -->
            <div class="row g-2 mb-3">
                <div class="col-sm-6">
                    <label class="form-label small fw-semibold text-uppercase text-muted">Category</label>
                    <select class="form-select" @bind="EditingCategoryString">
                        <option value="">📁 Uncategorised</option>
                        @foreach (var cat in Categories)
                        {
                            <option value="@cat.GlobalId">@cat.Icon @cat.Name</option>
                        }
                    </select>
                </div>
                <div class="col-sm-6">
                    <label class="form-label small fw-semibold text-uppercase text-muted">Paid From Bank Account</label>
                    <select class="form-select" @bind="EditingAccountString">
                        <option value="">🏦 Any / Unspecified</option>
                        @foreach (var acc in BankAccounts)
                        {
                            <option value="@acc.GlobalId">@acc.Icon @acc.AccountName</option>
                        }
                    </select>
                </div>
            </div>

            <!-- 5. Profile Owner (Admin only) -->
            @if (Session.CurrentUser?.Role == "Admin")
            {
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-uppercase text-muted">Profile Owner</label>
                    <select class="form-select" @bind="EditingMemberString">
                        <option value="">👨‍👩‍👧‍👦 Family-Wide Shared</option>
                        @foreach (var mem in FamilyMembers)
                        {
                            <option value="@mem.GlobalId">@mem.Avatar @mem.Name</option>
                        }
                    </select>
                </div>
            }

            <!-- 6. Icon & Colour Palette -->
            <div class="mb-3">
                <label class="form-label small fw-semibold text-uppercase text-muted">Choose Icon & Colour</label>
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    @foreach (var icon in QuickIcons)
                    {
                        <button type="button" class="btn btn-sm @(EditingItem.Icon == icon ? "btn-primary" : "btn-outline-secondary") px-2"
                                @onclick="() => EditingItem.Icon = icon">
                            @icon
                        </button>
                    }
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    @foreach (var col in QuickColours)
                    {
                        <button type="button" class="color-swatch-btn @(EditingItem.Colour == col ? "selected" : "")"
                                style="background-color: @col;"
                                @onclick="() => EditingItem.Colour = col"></button>
                    }
                </div>
            </div>

            <!-- 7. Notes -->
            <div class="mb-2">
                <label class="form-label small fw-semibold text-uppercase text-muted">Notes / Account ID</label>
                <input type="text" class="form-control form-control-sm" placeholder="e.g. Account number, Plan details, cancellation link..." @bind="EditingItem.Note" />
            </div>
        </div>
        <div class="modal-panel-footer">
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseModal">Cancel</button>
            <button type="button" class="btn btn-primary fw-semibold" @onclick="SaveRecurringAsync" disabled="@IsSaving">
                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <span>✓ Save Recurring Bill</span>
                }
            </button>
        </div>
    </div>
}

<!-- ── Mark As Paid Confirmation Modal ────────────────────────────────────── -->
@if (ItemToMarkPaid != null)
{
    var nextDue = ExpenseService.CalculateNextDueDate(ItemToMarkPaid.NextDueDate, ItemToMarkPaid.Frequency);

    <div class="modal-backdrop-custom" @onclick="() => ItemToMarkPaid = null"></div>
    <div class="modal-panel shadow-lg animate-in" style="max-width: 460px;">
        <div class="modal-panel-header">
            <h5 class="mb-0 fw-bold d-flex align-items-center gap-2 text-success">
                <span>✓ Confirm Payment</span>
            </h5>
            <button type="button" class="btn-close" @onclick="() => ItemToMarkPaid = null"></button>
        </div>
        <div class="modal-panel-body">
            <div class="p-3 mb-3 rounded-3 text-center" style="background: var(--dash-surface-raised); border: 1px solid var(--dash-border);">
                <span class="fs-4 d-block mb-1">@(ItemToMarkPaid.Icon ?? "🔁")</span>
                <h5 class="fw-bold mb-1" style="color: var(--dash-text);">@ItemToMarkPaid.Name</h5>
                <h3 class="fw-bold text-success mb-0" style="font-variant-numeric: tabular-nums;">
                    ₹ @PaidAmount.ToString("N2")
                </h3>
            </div>

            <!-- Custom Paid Amount (if variable) -->
            <div class="mb-3">
                <label class="form-label small fw-semibold text-muted text-uppercase">Actual Paid Amount (₹)</label>
                <input type="number" step="0.01" class="form-control" @bind="PaidAmount" />
            </div>

            <!-- Paid Date -->
            <div class="mb-3">
                <label class="form-label small fw-semibold text-muted text-uppercase">Payment Date</label>
                <input type="date" class="form-control" @bind="PaidDate" />
            </div>

            <!-- Charge Account -->
            <div class="mb-3">
                <label class="form-label small fw-semibold text-muted text-uppercase">Charged Account</label>
                <select class="form-select" @bind="PaidAccountString">
                    <option value="">— Use default (@(ItemToMarkPaid.BankAccount?.AccountName ?? "Unassigned")) —</option>
                    @foreach (var acc in BankAccounts)
                    {
                        <option value="@acc.GlobalId">@acc.Icon @acc.AccountName</option>
                    }
                </select>
            </div>

            <div class="alert alert-info py-2 px-3 small mb-0" style="font-size: 0.78rem;">
                ℹ️ <strong>Auto-Roll:</strong> Clicking confirm logs an expense of <strong>₹@PaidAmount.ToString("N2")</strong> into your transactions and advances next due date to <strong>@nextDue.ToString("dd MMM yyyy")</strong>.
            </div>
        </div>
        <div class="modal-panel-footer">
            <button class="btn btn-outline-secondary" @onclick="() => ItemToMarkPaid = null">Cancel</button>
            <button class="btn btn-success fw-semibold" @onclick="ExecuteMarkAsPaidAsync" disabled="@IsSaving">
                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Logging...</span>
                }
                else
                {
                    <span>✓ Confirm & Log Expense</span>
                }
            </button>
        </div>
    </div>
}

<!-- ── Delete Confirmation Modal ──────────────────────────────────────────── -->
@if (ItemToDelete != null)
{
    <div class="modal-backdrop-custom" @onclick="() => ItemToDelete = null"></div>
    <div class="modal-panel shadow-lg animate-in" style="max-width: 420px;">
        <div class="modal-panel-header">
            <h5 class="mb-0 fw-bold text-danger">⚠️ Confirm Delete</h5>
            <button type="button" class="btn-close" @onclick="() => ItemToDelete = null"></button>
        </div>
        <div class="modal-panel-body">
            <p style="color: var(--dash-text);">
                Are you sure you want to delete recurring subscription <strong>@ItemToDelete.Name</strong>?
            </p>
            <div class="p-2 rounded-2 mb-2 text-center" style="background: var(--dash-surface-raised);">
                <span class="fs-5 fw-bold text-danger">₹ @ItemToDelete.Amount.ToString("N2") / @ItemToDelete.Frequency</span>
                <span class="text-muted small d-block">Next due: @ItemToDelete.NextDueDate.ToString("dd MMM yyyy")</span>
            </div>
            <p class="text-muted small mb-0">Past logged expenses associated with this bill will not be affected.</p>
        </div>
        <div class="modal-panel-footer">
            <button class="btn btn-outline-secondary" @onclick="() => ItemToDelete = null">Cancel</button>
            <button class="btn btn-danger fw-semibold" @onclick="ExecuteDeleteAsync">
                Yes, Delete
            </button>
        </div>
    </div>
}

