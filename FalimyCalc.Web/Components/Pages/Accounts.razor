@code {
    private List<ExpenseService.BankAccountWithBalance> AccountsWithBalances = [];
    private List<FamilyMember> FamilyMembers = [];
    private bool IsLoading = true;
    private bool ShowForm = false;
    private bool IsSaving = false;
    private string? FormError;

    // Admin view toggle (defaults to admin's own account)
    private bool _showAllMembers = false;
    private bool _excludeJoint = false;
    private string? SelectedMemberId;

    // Filters & Search
    private string SearchText = string.Empty;
    private string ActiveTypeFilter = "all";
    private string SelectedSort = "name_asc";

    // Form fields
    private string FormName = string.Empty;
    private decimal FormInitialBalance = 0m;
    private string? FormBankName;
    private string FormAccountType = "Savings";
    private string? FormAccountNumberSuffix;
    private string FormColour = "#6366f1";
    private string FormIcon = "🏦";
    private Guid FormMemberGlobalId;
    private bool FormIsJoint = false;
    private HashSet<Guid> FormJointMemberIds = [];

    private BankAccount? EditingAccount;
    private BankAccount? AccountToDelete;

    private readonly List<string> PresetColors =
    [
        "#6366f1", "#10b981", "#f43f5e", "#f59e0b",
        "#06b6d4", "#3b82f6", "#a855f7", "#ec4899"
    ];

    private Guid? ActiveMemberFilter
    {
        get
        {
            if (Session.CurrentUser?.Role != "Admin")
                return Session.CurrentUser?.GlobalId;

            if (Guid.TryParse(SelectedMemberId, out var g))
                return g;

            return _showAllMembers ? null : Session.CurrentUser?.GlobalId;
        }
    }

    // Active Accounts (excludes accounts belonging to deleted profiles)
    private IEnumerable<ExpenseService.BankAccountWithBalance> ActiveAccounts =>
        AccountsWithBalances.Where(a => a.Owner != null && !a.Owner.IsDeleted);

    // Personal (without joint) accounts & Joint accounts subsets
    private IEnumerable<ExpenseService.BankAccountWithBalance> PersonalAccounts =>
        ActiveAccounts.Where(a => !a.Account.IsJoint);
    private IEnumerable<ExpenseService.BankAccountWithBalance> JointAccounts =>
        ActiveAccounts.Where(a => a.Account.IsJoint);

    // Accounts to display based on Joint exclusion mode
    private IEnumerable<ExpenseService.BankAccountWithBalance> DisplayedAccounts =>
        _excludeJoint ? PersonalAccounts : ActiveAccounts;

    // Computed KPI Metrics
    private decimal TotalNetBalance => DisplayedAccounts.Sum(a => a.CurrentBalance);
    private decimal PersonalNetBalance => PersonalAccounts.Sum(a => a.CurrentBalance);
    private decimal JointNetBalance => JointAccounts.Sum(a => a.CurrentBalance);
    private decimal TotalSpentAllAccounts => DisplayedAccounts.Sum(a => a.TotalSpent);
    private decimal TotalInitialBalance => DisplayedAccounts.Sum(a => a.InitialBalance);
    private int TotalTransactionsCount => DisplayedAccounts.Sum(a => a.TransactionCount);
    private int PositiveAccountsCount => DisplayedAccounts.Count(a => a.CurrentBalance >= 0);
    private int NegativeAccountsCount => DisplayedAccounts.Count(a => a.CurrentBalance < 0);
    private int PersonalAccountsCount => PersonalAccounts.Count();
    private int JointAccountsCount => JointAccounts.Count();

    // Filtered & Sorted Accounts
    private IEnumerable<ExpenseService.BankAccountWithBalance> FilteredAccounts
    {
        get
        {
            var query = DisplayedAccounts;

            // Search
            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                var term = SearchText.Trim();
                query = query.Where(a => a.Account.AccountName.Contains(term, StringComparison.OrdinalIgnoreCase)
                                      || (!string.IsNullOrEmpty(a.Account.BankName) && a.Account.BankName.Contains(term, StringComparison.OrdinalIgnoreCase))
                                      || (!string.IsNullOrEmpty(a.Account.AccountNumberSuffix) && a.Account.AccountNumberSuffix.Contains(term)));
            }

            // Type filter
            switch (ActiveTypeFilter)
            {
                case "personal":
                    query = query.Where(a => !a.Account.IsJoint);
                    break;
                case "joint":
                    query = query.Where(a => a.Account.IsJoint);
                    break;
                case "savings":
                    query = query.Where(a => string.Equals(a.Account.AccountType, "Savings", StringComparison.OrdinalIgnoreCase));
                    break;
                case "credit":
                    query = query.Where(a => string.Equals(a.Account.AccountType, "Credit Card", StringComparison.OrdinalIgnoreCase));
                    break;
                case "negative":
                    query = query.Where(a => a.CurrentBalance < 0);
                    break;
            }

            // Sorting
            query = SelectedSort switch
            {
                "bal_desc" => query.OrderByDescending(a => a.CurrentBalance),
                "bal_asc" => query.OrderBy(a => a.CurrentBalance),
                "spent_desc" => query.OrderByDescending(a => a.TotalSpent),
                _ => query.OrderBy(a => a.Account.AccountName)
            };

            return query;
        }
    }

    private void SetJointFilter(bool excludeJoint)
    {
        _excludeJoint = excludeJoint;
        if (_excludeJoint && ActiveTypeFilter == "joint")
        {
            ActiveTypeFilter = "all";
        }
    }

    private void SetActiveTypeFilter(string filter)
    {
        ActiveTypeFilter = filter;
        if (filter == "personal")
        {
            _excludeJoint = true;
        }
        else if (filter == "joint")
        {
            _excludeJoint = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        FamilyMembers = await ExpenseService.GetFamilyMembersAsync();
        _showAllMembers = false;
        await LoadAccounts();
    }

    private async Task SetViewMode(bool showAll)
    {
        _showAllMembers = showAll;
        SelectedMemberId = null;
        await LoadAccounts();
    }

    private async Task OnMemberFilterChanged()
    {
        if (string.IsNullOrEmpty(SelectedMemberId))
        {
            _showAllMembers = true;
        }
        else if (Guid.TryParse(SelectedMemberId, out var sg) && sg == Session.CurrentUser?.GlobalId)
        {
            _showAllMembers = false;
        }
        await LoadAccounts();
    }

    private async Task LoadAccounts()
    {
        IsLoading = true;
        AccountsWithBalances = await ExpenseService.GetBankAccountsWithBalancesAsync(ActiveMemberFilter);
        IsLoading = false;
    }

    private void ToggleJointMember(Guid memberId)
    {
        if (FormJointMemberIds.Contains(memberId))
            FormJointMemberIds.Remove(memberId);
        else
            FormJointMemberIds.Add(memberId);
    }

    private void ShowAddForm()
    {
        EditingAccount = null;
        FormName = string.Empty;
        FormInitialBalance = 0m;
        FormBankName = string.Empty;
        FormAccountType = "Savings";
        FormAccountNumberSuffix = string.Empty;
        FormColour = "#6366f1";
        FormIcon = "🏦";
        FormMemberGlobalId = Session.CurrentUser?.GlobalId ?? Guid.Empty;
        FormIsJoint = false;
        FormJointMemberIds.Clear();
        FormError = null;
        ShowForm = true;
    }

    private void StartEdit(BankAccount acc)
    {
        EditingAccount = acc;
        FormName = acc.AccountName;
        FormInitialBalance = acc.InitialBalance;
        FormBankName = acc.BankName;
        FormAccountType = acc.AccountType ?? "Savings";
        FormAccountNumberSuffix = acc.AccountNumberSuffix;
        FormColour = acc.Colour ?? "#6366f1";
        FormIcon = acc.Icon ?? "🏦";
        FormMemberGlobalId = acc.MemberGlobalId;
        FormIsJoint = acc.IsJoint;
        FormJointMemberIds = acc.GetJointMemberGuids().ToHashSet();
        FormError = null;
        ShowForm = true;
    }

    private void HideForm()
    {
        ShowForm = false;
        EditingAccount = null;
        FormError = null;
    }

    private async Task SaveAccount()
    {
        FormError = null;

        if (string.IsNullOrWhiteSpace(FormName))
        {
            FormError = "Account Name is required.";
            return;
        }

        if (FormIsJoint && !FormJointMemberIds.Any())
        {
            FormError = "Please select at least one other family member to share this joint account with.";
            return;
        }

        IsSaving = true;

        try
        {
            var targetMemberId = Session.CurrentUser?.Role == "Admin"
                ? (FormMemberGlobalId != Guid.Empty ? FormMemberGlobalId : (Session.CurrentUser?.GlobalId ?? Guid.Empty))
                : (Session.CurrentUser?.GlobalId ?? Guid.Empty);

            var jointIds = FormIsJoint && FormJointMemberIds.Any()
                ? string.Join(",", FormJointMemberIds)
                : null;

            if (EditingAccount is null)
            {
                await ExpenseService.CreateBankAccountAsync(new BankAccount
                {
                    AccountName = FormName.Trim(),
                    InitialBalance = FormInitialBalance,
                    BankName = string.IsNullOrWhiteSpace(FormBankName) ? null : FormBankName.Trim(),
                    AccountType = FormAccountType,
                    AccountNumberSuffix = string.IsNullOrWhiteSpace(FormAccountNumberSuffix) ? null : FormAccountNumberSuffix.Trim(),
                    Colour = FormColour,
                    Icon = FormIcon,
                    IsJoint = FormIsJoint,
                    JointMemberGlobalIds = jointIds
                }, targetMemberId);
            }
            else
            {
                await ExpenseService.UpdateBankAccountAsync(new BankAccount
                {
                    GlobalId = EditingAccount.GlobalId,
                    AccountName = FormName.Trim(),
                    InitialBalance = FormInitialBalance,
                    BankName = string.IsNullOrWhiteSpace(FormBankName) ? null : FormBankName.Trim(),
                    AccountType = FormAccountType,
                    AccountNumberSuffix = string.IsNullOrWhiteSpace(FormAccountNumberSuffix) ? null : FormAccountNumberSuffix.Trim(),
                    Colour = FormColour,
                    Icon = FormIcon,
                    MemberGlobalId = targetMemberId,
                    IsJoint = FormIsJoint,
                    JointMemberGlobalIds = jointIds
                });
            }

            HideForm();
            await LoadAccounts();
        }
        catch (Exception ex)
        {
            FormError = $"Failed to save account: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void ConfirmDelete(BankAccount acc) => AccountToDelete = acc;
    private void CancelDelete() => AccountToDelete = null;

    private async Task DeleteConfirmed()
    {
        if (AccountToDelete is not null)
        {
            await ExpenseService.DeleteBankAccountAsync(AccountToDelete.GlobalId);
            AccountToDelete = null;
            await LoadAccounts();
        }
    }
}
