<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FalimyCalc.Mobile.Views.DashboardPage"
             Title="Dashboard">

    <RefreshView x:Name="RefreshView" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Monthly total card -->
                <Border BackgroundColor="{AppThemeBinding Light=#FFF0F0, Dark=#3D0000}"
                        StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="This Month's Spending" FontSize="13"
                               TextColor="{AppThemeBinding Light=#666, Dark=#ccc}" />
                        <Label x:Name="MonthlyTotalLabel" Text="₹ 0.00"
                               FontSize="32" FontAttributes="Bold"
                               TextColor="#E53935" />
                        <Label x:Name="MonthLabel" FontSize="12"
                               TextColor="{AppThemeBinding Light=#888, Dark=#aaa}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Quick action -->
                <Button Text="+ Add Expense"
                        BackgroundColor="#1976D2" TextColor="White"
                        CornerRadius="8" Clicked="OnAddExpenseClicked" />

                <!-- Recent expenses -->
                <Label Text="Recent Expenses" FontSize="16" FontAttributes="Bold"
                       Margin="0,8,0,0" />

                <CollectionView x:Name="RecentExpensesCollection"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="No expenses yet. Tap '+ Add Expense' to get started."
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#888, Dark=#aaa}"
                               Margin="0,16" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4" Padding="12" StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Description}"
                                           FontAttributes="Bold" FontSize="14"
                                           LineBreakMode="TailTruncation" MaxLines="1" />
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding Amount, StringFormat='₹ {0:N2}'}"
                                           FontAttributes="Bold" FontSize="15"
                                           TextColor="#E53935" VerticalOptions="Start" />
                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="{Binding TransactionDate, StringFormat='{0:dd MMM yyyy}'}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#888, Dark=#aaa}"
                                           VerticalOptions="Center" />
                                    <Button Grid.Row="1" Grid.Column="1"
                                            Text="Del" FontSize="11" Padding="8,4"
                                            HeightRequest="32" BackgroundColor="#E53935"
                                            TextColor="White" CornerRadius="6"
                                            Clicked="OnDeleteClicked"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="View All Expenses" Style="{StaticResource OutlinedButton}"
                        Clicked="OnViewAllClicked" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
